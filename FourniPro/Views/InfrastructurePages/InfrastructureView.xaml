<UserControl x:Class="FourniPro.Views.InfrastructurePages.InfrastructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FourniPro.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{DynamicResource NeuAccentBrush}"
                                    CornerRadius="3"
                                    Margin="2,0" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ScrollViewer.Resources>

        <StackPanel Margin="32,28,32,32">

            <!-- ─── Page header ─── -->
            <Grid Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [InfraTitle], Source={x:Static loc:LanguageManager.Instance}}"
                               FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                    <TextBlock Text="{Binding [InfraSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                               FontSize="13" Margin="0,4,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                </StackPanel>

                <!-- Back button — only visible in section state -->
                <Button x:Name="BackButton"
                        Click="Back_Click"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        ToolTip="{Binding [InfraBackTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                        Style="{StaticResource NeuButtonStyle}"
                        Background="{DynamicResource NeuAccentBrush}"
                        Foreground="White"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [InfraBackButton], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontWeight="SemiBold" FontSize="14"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════
                 STATE 1 — Landing hub: section cards
                 ═══════════════════════════════════════════════════ -->
            <UniformGrid x:Name="LandingPanel" Columns="4" Visibility="Visible">

                <!-- Produits -->
                <Button Tag="produits"
                        Click="Card_Click"
                        Margin="12"
                        Cursor="Hand"
                        ToolTip="{Binding [InfraCardDescProduits], Source={x:Static loc:LanguageManager.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                            <Border x:Name="CardInner" CornerRadius="24"
                                                    Background="{DynamicResource NeuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NeuAccentBrush}"
                                                    BorderThickness="1.5"
                                                    Effect="{DynamicResource NeuShadowCardLight}">
                                                <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="CardIcon"
                                                                   Symbol="Beaker24"
                                                                   FontSize="48"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                                   Margin="0,0,0,12" />
                                                    <TextBlock x:Name="CardTitle"
                                                               Text="{Binding [InfraProduits], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="17" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                    <TextBlock x:Name="CardDesc"
                                                               Text="{Binding [InfraCardDescProduits], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="14" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Clients -->
                <Button Tag="clients"
                        Click="Card_Click"
                        Margin="12"
                        Cursor="Hand"
                        ToolTip="{Binding [InfraCardDescClients], Source={x:Static loc:LanguageManager.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                            <Border x:Name="CardInner" CornerRadius="24"
                                                    Background="{DynamicResource NeuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NeuAccentBrush}"
                                                    BorderThickness="1.5"
                                                    Effect="{DynamicResource NeuShadowCardLight}">
                                                <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="CardIcon"
                                                                   Symbol="PersonBoard24"
                                                                   FontSize="48"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                                   Margin="0,0,0,12" />
                                                    <TextBlock x:Name="CardTitle"
                                                               Text="{Binding [InfraClients], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="17" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                    <TextBlock x:Name="CardDesc"
                                                               Text="{Binding [InfraCardDescClients], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="14" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Chauffeurs -->
                <Button Tag="chauffeurs"
                        Click="Card_Click"
                        Margin="12"
                        Cursor="Hand"
                        ToolTip="{Binding [InfraCardDescChauffeurs], Source={x:Static loc:LanguageManager.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                            <Border x:Name="CardInner" CornerRadius="24"
                                                    Background="{DynamicResource NeuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NeuAccentBrush}"
                                                    BorderThickness="1.5"
                                                    Effect="{DynamicResource NeuShadowCardLight}">
                                                <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="CardIcon"
                                                                   Symbol="VehicleCar24"
                                                                   FontSize="48"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                                   Margin="0,0,0,12" />
                                                    <TextBlock x:Name="CardTitle"
                                                               Text="{Binding [InfraChauffeurs], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="17" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                    <TextBlock x:Name="CardDesc"
                                                               Text="{Binding [InfraCardDescChauffeurs], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="14" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Fournisseurs -->
                <Button Tag="fournisseurs"
                        Click="Card_Click"
                        Margin="12"
                        Cursor="Hand"
                        ToolTip="{Binding [InfraCardDescFournisseurs], Source={x:Static loc:LanguageManager.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                            <Border x:Name="CardInner" CornerRadius="24"
                                                    Background="{DynamicResource NeuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NeuAccentBrush}"
                                                    BorderThickness="1.5"
                                                    Effect="{DynamicResource NeuShadowCardLight}">
                                                <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="CardIcon"
                                                                   Symbol="People24"
                                                                   FontSize="48"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                                   Margin="0,0,0,12" />
                                                    <TextBlock x:Name="CardTitle"
                                                               Text="{Binding [InfraFournisseurs], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="17" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                    <TextBlock x:Name="CardDesc"
                                                               Text="{Binding [InfraCardDescFournisseurs], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="14" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Citernes -->
                <Button Tag="citernes"
                        Click="Card_Click"
                        Margin="12"
                        Cursor="Hand"
                        ToolTip="{Binding [InfraCardDescCiternes], Source={x:Static loc:LanguageManager.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                            <Border x:Name="CardInner" CornerRadius="24"
                                                    Background="{DynamicResource NeuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NeuAccentBrush}"
                                                    BorderThickness="1.5"
                                                    Effect="{DynamicResource NeuShadowCardLight}">
                                                <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="CardIcon"
                                                                   Symbol="Drop24"
                                                                   FontSize="48"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                                   Margin="0,0,0,12" />
                                                    <TextBlock x:Name="CardTitle"
                                                               Text="{Binding [InfraCiternes], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="17" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                    <TextBlock x:Name="CardDesc"
                                                               Text="{Binding [InfraCardDescCiternes], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="14" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Camions -->
                <Button Tag="camions"
                        Click="Card_Click"
                        Margin="12"
                        Cursor="Hand"
                        ToolTip="{Binding [InfraCardDescCamions], Source={x:Static loc:LanguageManager.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                            <Border x:Name="CardInner" CornerRadius="24"
                                                    Background="{DynamicResource NeuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NeuAccentBrush}"
                                                    BorderThickness="1.5"
                                                    Effect="{DynamicResource NeuShadowCardLight}">
                                                <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="CardIcon"
                                                                   Symbol="VehicleTruck24"
                                                                   FontSize="48"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                                   Margin="0,0,0,12" />
                                                    <TextBlock x:Name="CardTitle"
                                                               Text="{Binding [InfraCamions], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="17" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                    <TextBlock x:Name="CardDesc"
                                                               Text="{Binding [InfraCardDescCamions], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="14" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Achats -->
                <Button Tag="achats"
                        Click="Card_Click"
                        Margin="12"
                        Cursor="Hand"
                        ToolTip="{Binding [InfraCardDescAchats], Source={x:Static loc:LanguageManager.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                            <Border x:Name="CardInner" CornerRadius="24"
                                                    Background="{DynamicResource NeuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NeuAccentBrush}"
                                                    BorderThickness="1.5"
                                                    Effect="{DynamicResource NeuShadowCardLight}">
                                                <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="CardIcon"
                                                                   Symbol="Cart24"
                                                                   FontSize="48"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                                   Margin="0,0,0,12" />
                                                    <TextBlock x:Name="CardTitle"
                                                               Text="{Binding [InfraAchats], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="17" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                    <TextBlock x:Name="CardDesc"
                                                               Text="{Binding [InfraCardDescAchats], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="14" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Ventes -->
                <Button Tag="ventes"
                        Click="Card_Click"
                        Margin="12"
                        Cursor="Hand"
                        ToolTip="{Binding [InfraCardDescVentes], Source={x:Static loc:LanguageManager.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                            <Border x:Name="CardInner" CornerRadius="24"
                                                    Background="{DynamicResource NeuBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NeuAccentBrush}"
                                                    BorderThickness="1.5"
                                                    Effect="{DynamicResource NeuShadowCardLight}">
                                                <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="CardIcon"
                                                                   Symbol="Receipt24"
                                                                   FontSize="48"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                                   Margin="0,0,0,12" />
                                                    <TextBlock x:Name="CardTitle"
                                                               Text="{Binding [InfraVentes], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="17" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                    <TextBlock x:Name="CardDesc"
                                                               Text="{Binding [InfraCardDescVentes], Source={x:Static loc:LanguageManager.Instance}}"
                                                               FontSize="14" Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                                            <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                                            <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                                            <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Employes -->
                                            <Button Tag="employes"
                                                    Click="Card_Click"
                                                    Margin="12"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding [InfraCardDescEmployes], Source={x:Static loc:LanguageManager.Instance}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="CardOuter" CornerRadius="24"
                                                                            Background="{DynamicResource NeuBackgroundBrush}"
                                                                            Effect="{DynamicResource NeuShadowCard}">
                                                                        <Border x:Name="CardInner" CornerRadius="24"
                                                                                Background="{DynamicResource NeuBackgroundBrush}"
                                                                                BorderBrush="{DynamicResource NeuAccentBrush}"
                                                                                BorderThickness="1.5"
                                                                                Effect="{DynamicResource NeuShadowCardLight}">
                                                                            <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <ui:SymbolIcon x:Name="CardIcon"
                                                                                               Symbol="People24"
                                                                                               FontSize="48"
                                                                                               HorizontalAlignment="Center"
                                                                                               Foreground="{DynamicResource NeuAccentBrush}"
                                                                                               Margin="0,0,0,12" />
                                                                                <TextBlock x:Name="CardTitle"
                                                                                           Text="{Binding [InfraEmployes], Source={x:Static loc:LanguageManager.Instance}}"
                                                                                           FontSize="17" FontWeight="SemiBold"
                                                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                                                           Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                                                <TextBlock x:Name="CardDesc"
                                                                                           Text="{Binding [InfraCardDescEmployes], Source={x:Static loc:LanguageManager.Instance}}"
                                                                                           FontSize="14" Margin="0,5,0,0"
                                                                                           TextWrapping="Wrap"
                                                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                                                           Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                                            <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                                            <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                                            <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Crédits -->
                                            <Button Tag="credits"
                                                    Click="Card_Click"
                                                    Margin="12"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding [InfraCardDescCredits], Source={x:Static loc:LanguageManager.Instance}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                                                        <Border x:Name="CardInner" CornerRadius="24"
                                                                                Background="{DynamicResource NeuBackgroundBrush}"
                                                                                BorderBrush="{DynamicResource NeuAccentBrush}"
                                                                                BorderThickness="1.5"
                                                                                Effect="{DynamicResource NeuShadowCardLight}">
                                                                            <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <ui:SymbolIcon x:Name="CardIcon"
                                                                                               Symbol="Money24"
                                                                                               FontSize="48"
                                                                                               HorizontalAlignment="Center"
                                                                                               Foreground="{DynamicResource NeuAccentBrush}"
                                                                                               Margin="0,0,0,12" />
                                                                                <TextBlock x:Name="CardTitle"
                                                                                           Text="{Binding [InfraCredits], Source={x:Static loc:LanguageManager.Instance}}"
                                                                                           FontSize="17" FontWeight="SemiBold"
                                                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                                                           Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                                                <TextBlock x:Name="CardDesc"
                                                                                           Text="{Binding [InfraCardDescCredits], Source={x:Static loc:LanguageManager.Instance}}"
                                                                                           FontSize="14" Margin="0,5,0,0"
                                                                                           TextWrapping="Wrap"
                                                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                                                           Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                                            <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                                            <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                                            <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                                            </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>

                                                                        <!-- Voyages -->
                                                                        <Button Tag="voyages"
                                                                                Click="Card_Click"
                                                                                Margin="12"
                                                                                Cursor="Hand"
                                                                                ToolTip="{Binding [InfraCardDescVoyages], Source={x:Static loc:LanguageManager.Instance}}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button">
                                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                                    <Setter Property="Padding" Value="0" />
                                                                                    <Setter Property="Background" Value="Transparent" />
                                                                                    <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                            <ControlTemplate TargetType="Button">
                                                                                                <Border CornerRadius="24" Effect="{DynamicResource NeuShadowCardDark}">
                                                                                                    <Border x:Name="CardInner" CornerRadius="24"
                                                                                                            Background="{DynamicResource NeuBackgroundBrush}"
                                                                                                            BorderBrush="{DynamicResource NeuAccentBrush}"
                                                                                                            BorderThickness="1.5"
                                                                                                            Effect="{DynamicResource NeuShadowCardLight}">
                                                                                                        <StackPanel Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                            <ui:SymbolIcon x:Name="CardIcon"
                                                                                                                           Symbol="VehicleTruck24"
                                                                                                                           FontSize="48"
                                                                                                                           HorizontalAlignment="Center"
                                                                                                                           Foreground="{DynamicResource NeuAccentBrush}"
                                                                                                                           Margin="0,0,0,12" />
                                                                                                            <TextBlock x:Name="CardTitle"
                                                                                                                       Text="{Binding [InfraVoyages], Source={x:Static loc:LanguageManager.Instance}}"
                                                                                                                       FontSize="17" FontWeight="SemiBold"
                                                                                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                                                                                       Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                                                                                                            <TextBlock x:Name="CardDesc"
                                                                                                                       Text="{Binding [InfraCardDescVoyages], Source={x:Static loc:LanguageManager.Instance}}"
                                                                                                                       FontSize="14" Margin="0,5,0,0"
                                                                                                                       TextWrapping="Wrap"
                                                                                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                                                                                       Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                                                                        </StackPanel>
                                                                                                    </Border>
                                                                                                </Border>
                                                                                                <ControlTemplate.Triggers>
                                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                                        <Setter TargetName="CardInner" Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                                                                                        <Setter TargetName="CardIcon"  Property="Foreground" Value="White" />
                                                                                                        <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                                                                                        <Setter TargetName="CardDesc"  Property="Foreground" Value="White" />
                                                                                                    </Trigger>
                                                                                                </ControlTemplate.Triggers>
                                                                                            </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>

                                                                    </UniformGrid>

            <!-- ═══════════════════════════════════════════════════
                 STATE 2 — Section view host
                 ═══════════════════════════════════════════════════ -->
            <StackPanel x:Name="SectionPanel" Visibility="Collapsed">
                <ContentControl x:Name="SectionHost" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
