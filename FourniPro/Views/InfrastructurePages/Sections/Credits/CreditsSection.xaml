<UserControl x:Class="FourniPro.Views.InfrastructurePages.Sections.Credits.CreditsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FourniPro.Localization"
             xmlns:vm="clr-namespace:FourniPro.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CreditsSectionViewModel}"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />


        <Style x:Key="CreditIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource NeuActionIconBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource NeuActionBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource NeuActionHoverFillBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreditDeleteBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource NeuDangerBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource NeuActionDeleteBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource NeuDangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreditColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CreditCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Row template -->
        <DataTemplate x:Key="CreditRowTemplate">
            <Border Padding="0,10,0,10"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <!-- Numéro badge -->
                    <Border Grid.Column="0" Background="{DynamicResource NeuInputFillBrush}"
                            CornerRadius="6" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NumeroCredit}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                    </Border>

                    <!-- Date -->
                    <TextBlock Grid.Column="1" Text="{Binding DateCredit, StringFormat=dd/MM/yyyy}"
                               Style="{StaticResource CreditCellTextStyle}" HorizontalAlignment="Left" />

                    <!-- Client -->
                    <TextBlock Grid.Column="2" Text="{Binding ClientNom, TargetNullValue='—'}"
                               Style="{StaticResource CreditCellTextStyle}" HorizontalAlignment="Left" />

                    <!-- Produit -->
                    <TextBlock Grid.Column="3" Text="{Binding ProduitNom, TargetNullValue='—'}"
                               Style="{StaticResource CreditCellTextStyle}" HorizontalAlignment="Left" />

                    <!-- Employé -->
                    <TextBlock Grid.Column="4" Text="{Binding EmployeNom, TargetNullValue='—'}"
                               Style="{StaticResource CreditCellTextStyle}" HorizontalAlignment="Left" />

                    <!-- Quantité -->
                    <TextBlock Grid.Column="5" Text="{Binding Quantite, TargetNullValue='—'}"
                               Style="{StaticResource CreditCellTextStyle}" HorizontalAlignment="Left" />

                    <!-- Montant total -->
                    <TextBlock Grid.Column="6" Style="{StaticResource CreditCellTextStyle}"
                               Foreground="{DynamicResource NeuAccentBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Left">
                        <Run Text="{Binding MontantTotal, StringFormat='{}{0:N2}', TargetNullValue='—'}" />
                        <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" FontWeight="Normal" />
                    </TextBlock>

                    <!-- Prix unitaire -->
                    <TextBlock Grid.Column="7" Style="{StaticResource CreditCellTextStyle}"
                               HorizontalAlignment="Left">
                        <Run Text="{Binding PrixUnitaire, StringFormat='{}{0:N2}', TargetNullValue='—'}" />
                        <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                    </TextBlock>

                    <!-- Statut badge -->
                    <Border Grid.Column="8" CornerRadius="6" Padding="7,3"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Statut}" Value="Soldé">
                                        <Setter Property="Background" Value="#1A22C55E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Statut}" Value="Partiel">
                                        <Setter Property="Background" Value="#1AF59E0B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Statut}" Value="Impayé">
                                        <Setter Property="Background" Value="#1AEF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Statut, TargetNullValue='—'}"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Statut}" Value="Soldé">
                                            <Setter Property="Foreground" Value="#22C55E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Statut}" Value="Partiel">
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Statut}" Value="Impayé">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Chèque icon -->
                    <ui:SymbolIcon Grid.Column="9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="15">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Prohibited24" />
                                <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
                                <Setter Property="Opacity" Value="0.4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChequeReference, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                        <Setter Property="Symbol" Value="DocumentCheckmark24" />
                                        <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <!-- Actions -->
                    <StackPanel Grid.Column="10" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource CreditIconButtonStyle}"
                                ToolTip="{Binding [CreditDetailTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                                Command="{Binding DataContext.DetailCreditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Eye24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource CreditIconButtonStyle}"
                                Margin="4,0,0,0"
                                ToolTip="{Binding [CreditEditTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                                Command="{Binding DataContext.EditCreditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource CreditDeleteBtnStyle}"
                                Margin="4,0,0,0"
                                ToolTip="{Binding [CreditDeleteTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                                Command="{Binding DataContext.DeleteCreditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Header ─── -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [ProdBreadcrumbInfra], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                        <TextBlock Text=" › " FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                        <TextBlock Text="{Binding [CreditBreadcrumb], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding [CreditPageSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource NeuButtonStyle}"
                        Background="{DynamicResource NeuAccentBrush}"
                        Foreground="White"
                        Padding="16,10"
                        FontWeight="SemiBold"
                        Command="{Binding AddCreditCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [CreditAddButton], Source={x:Static loc:LanguageManager.Instance}}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ─── Table card ─── -->
            <ContentControl Grid.Row="1"
                            Style="{StaticResource NeuDashCardStyle}"
                            Margin="8,0,8,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [CreditTableTitle], Source={x:Static loc:LanguageManager.Instance}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                            <TextBlock Text="{Binding [CreditTableSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                                       FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource NeuInputFillBrush}"
                                    CornerRadius="10" Padding="12,5" Margin="0,0,12,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource NeuAccentBrush}">
                                    <Run Text="{Binding Credits.Count, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding [CreditCountBadge], Source={x:Static loc:LanguageManager.Instance}, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Button Style="{StaticResource NeuButtonStyle}"
                                    Padding="10,8"
                                    Command="{Binding RefreshCommand}">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Column headers -->
                    <Grid Grid.Row="1" Margin="0,16,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"  Text="{Binding [CreditColNumero],    Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1"  Text="{Binding [CreditColDate],      Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2"  Text="{Binding [CreditColClient],    Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="3"  Text="{Binding [CreditColProduit],   Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="4"  Text="{Binding [CreditColEmploye],   Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="5"  Text="{Binding [CreditColQte],       Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="6"  Text="{Binding [CreditColMontant],   Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="7"  Text="{Binding [CreditColPrix],      Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="8"  Text="{Binding [CreditColStatut],    Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="9"  Text="{Binding [CreditColCheque],    Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="10" Text="{Binding [CreditColActions],   Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CreditColHeaderStyle}" HorizontalAlignment="Center" />
                    </Grid>

                    <!-- Rows -->
                    <Grid Grid.Row="2" MinHeight="120">
                        <ItemsControl ItemsSource="{Binding Credits}"
                                      ItemTemplate="{StaticResource CreditRowTemplate}"
                                      AlternationCount="2" />

                        <!-- Loading overlay -->
                        <Border Background="#33000000" CornerRadius="8"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="40" Height="40"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource NeuAccentBrush}" />
                        </Border>

                        <!-- Empty state -->
                        <TextBlock Text="{Binding [CreditEmpty], Source={x:Static loc:LanguageManager.Instance}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,40,0,0" FontSize="13"
                                   Foreground="{DynamicResource NeuTextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                                <Condition Binding="{Binding Credits.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>
    </ScrollViewer>

</UserControl>

