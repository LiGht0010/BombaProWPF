<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.Credits.DetailCreditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FourniPro.Localization"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="{Binding [DetailCreditTitle], Source={x:Static loc:LanguageManager.Instance}}"
                 Width="900" Height="720"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource NeuBackgroundBrush}">

    <ui:FluentWindow.Resources>

        <Style x:Key="DlgCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuBackgroundBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="12" />
            <Setter Property="Padding"         Value="20,18" />
            <Setter Property="Margin"          Value="0,0,0,12" />
        </Style>

        <Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DlgIconCircleStyle" TargetType="Border">
            <Setter Property="Width"             Value="28" />
            <Setter Property="Height"            Value="28" />
            <Setter Property="CornerRadius"      Value="14" />
            <Setter Property="Background"        Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,10,0" />
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="Margin"     Value="0,0,0,3" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="13" />
            <Setter Property="Foreground"    Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="TextWrapping"  Value="Wrap" />
        </Style>

        <Style x:Key="DetailAccentValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
        </Style>

        <Style x:Key="DlgCloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width"           Value="32" />
            <Setter Property="Height"          Value="32" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="14,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="20,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <!-- Outer shell -->
    <Border CornerRadius="14"
            Background="{DynamicResource NeuBackgroundBrush}"
            BorderBrush="{DynamicResource NeuInputFillBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Header ─── -->
            <Grid Grid.Row="0" Margin="22,18,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource DlgCloseButtonStyle}" Click="OnCloseClick">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </Button>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [DetailCreditTitle], Source={x:Static loc:LanguageManager.Instance}}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource NeuJaugAccentBrush}"/>
                    <TextBlock Text="{Binding NumeroCredit}"
                               FontSize="12"
                               Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource DlgIconCircleStyle}">
                    <ui:SymbolIcon Symbol="Money24" FontSize="14"
                                   Foreground="{DynamicResource NeuAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- ─── Body: 2×2 card grid ─── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="18,8,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Card 1: Identification (top-left) ── -->
                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [DetailCreditCardIdentification], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Numéro -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelNumero], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding NumeroCredit, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource NeuAccentBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <!-- Date -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelDate], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding DateCredit, StringFormat=dd/MM/yyyy, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource NeuInputFillBrush}" Height="1" Margin="0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Statut -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelStatut], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Soldé">
                                                        <Setter Property="Background" Value="#1A22C55E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Partiel">
                                                        <Setter Property="Background" Value="#1AF59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Impayé">
                                                        <Setter Property="Background" Value="#1AEF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Statut, TargetNullValue='—'}"
                                                   FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Soldé">
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Partiel">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Impayé">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <!-- Référence -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelReference], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding Reference, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 2: Commercial (top-right) ── -->
                    <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [DetailCreditCardCommercial], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Client -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelClient], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding ClientNom, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <!-- Produit -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelProduit], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding ProduitNom, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource NeuInputFillBrush}" Height="1" Margin="0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Employé -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelEmploye], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding EmployeNom, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <!-- Quantité -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelQuantite], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding Quantite, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 3: Financier (bottom-left) ── -->
                    <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Money24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [DetailCreditCardFinancier], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Prix unitaire -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelPrixUnitaire], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Style="{StaticResource DetailValueStyle}">
                                        <Run Text="{Binding PrixUnitaire, StringFormat='{}{0:N2}', TargetNullValue='—'}"/>
                                        <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <!-- Remise -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelRemise], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Style="{StaticResource DetailValueStyle}">
                                        <Run Text="{Binding Remise, StringFormat='{}{0:N2}', TargetNullValue='0.00'}"/>
                                        <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Montant total pill -->
                            <Border Background="{DynamicResource NeuInputFillBrush}"
                                    CornerRadius="10" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [DetailCreditLabelMontantTotal], Source={x:Static loc:LanguageManager.Instance}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding [DetailCreditLabelMontantSub], Source={x:Static loc:LanguageManager.Instance}}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                        <Run Text="{Binding MontantTotal, StringFormat='{}{0:N2}', TargetNullValue='—'}"
                                             FontSize="20" FontWeight="Bold"
                                             Foreground="{DynamicResource NeuTextPrimaryBrush}"/>
                                        <Run Text=" DH" FontSize="13" FontWeight="SemiBold"
                                             Foreground="{DynamicResource NeuAccentBrush}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 4: Chèque + Audit (bottom-right) ── -->
                    <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="DocumentCheckmark24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [DetailCreditCardCheque], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Référence chèque -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelChequeRef], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding ChequeReference, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <!-- Statut chèque -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelStatutCheque], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding StatutCheque, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource NeuInputFillBrush}" Height="1" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Ajouté par -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelAjoutePar], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding AjouteParNom, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                    <TextBlock Text="{Binding DateCreation, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=''}"
                                               FontSize="10"
                                               Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <!-- Modifié par -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailCreditLabelModifiePar], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding ModifieParNom, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                    <TextBlock Text="{Binding DateModification, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=''}"
                                               FontSize="10"
                                               Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Note -->
                            <Border Background="{DynamicResource NeuInputFillBrush}" Height="1" Margin="0,14"/>
                            <TextBlock Text="{Binding [DetailCreditLabelNote], Source={x:Static loc:LanguageManager.Instance}}"
                                       Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding Note, TargetNullValue='—'}"
                                       Style="{StaticResource DetailValueStyle}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>

            <!-- ─── Footer ─── -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="22,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DlgSecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Content="{Binding [DetailCreditClose], Source={x:Static loc:LanguageManager.Instance}}"
                            Click="OnCloseClick"/>
                    <Button Style="{StaticResource DlgPrimaryButtonStyle}"
                            Click="OnEditClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [DetailCreditEdit], Source={x:Static loc:LanguageManager.Instance}}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</ui:FluentWindow>
