<UserControl x:Class="FourniPro.Views.InfrastructurePages.Sections.Achats.AchatsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FourniPro.Localization"
             xmlns:vm="clr-namespace:FourniPro.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AchatsSectionViewModel}"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="AchatIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource NeuActionIconBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource NeuActionBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource NeuActionHoverFillBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AchatDeleteBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource NeuDangerBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource NeuActionDeleteBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource NeuDangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AchatColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AchatCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Row template -->
        <DataTemplate x:Key="AchatRowTemplate">
            <Border Padding="0,12,0,12"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <!-- Numéro badge -->
                    <Border Grid.Column="0" Background="{DynamicResource NeuInputFillBrush}"
                            CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Numero}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                    </Border>

                    <!-- Date -->
                    <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat=dd/MM/yyyy}"
                               Style="{StaticResource AchatCellTextStyle}" HorizontalAlignment="Left" />

                    <!-- Fournisseur -->
                    <TextBlock Grid.Column="2" Text="{Binding FournisseurNom}"
                               Style="{StaticResource AchatCellTextStyle}" HorizontalAlignment="Left" />

                    <!-- Produit -->
                    <TextBlock Grid.Column="3" Text="{Binding ProduitNom}"
                               Style="{StaticResource AchatCellTextStyle}" HorizontalAlignment="Left" />

                    <!-- Quantité -->
                    <TextBlock Grid.Column="4" Text="{Binding Quantite}"
                               Style="{StaticResource AchatCellTextStyle}" HorizontalAlignment="Left" />

                    <!-- Coût -->
                    <TextBlock Grid.Column="5" Style="{StaticResource AchatCellTextStyle}" HorizontalAlignment="Left">
                        <Run Text="{Binding Cout, StringFormat='{}{0:F2}'}" />
                        <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                    </TextBlock>

                    <!-- Livraison défectueuse -->
                    <ui:SymbolIcon Grid.Column="6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LivraisonDefectueuse}" Value="True">
                                        <Setter Property="Symbol" Value="DismissCircle24" />
                                        <Setter Property="Foreground" Value="{DynamicResource NeuDangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <!-- Actions -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource AchatIconButtonStyle}"
                                ToolTip="{Binding [AchatDetailTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                                Command="{Binding DataContext.DetailAchatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Eye24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource AchatIconButtonStyle}"
                                Margin="4,0,0,0"
                                ToolTip="{Binding [AchatEditTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                                Command="{Binding DataContext.EditAchatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource AchatDeleteBtnStyle}"
                                Margin="4,0,0,0"
                                ToolTip="{Binding [AchatDeleteTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                                Command="{Binding DataContext.DeleteAchatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Header: breadcrumb + Add button ─── -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [ProdBreadcrumbInfra], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                        <TextBlock Text=" › " FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                        <TextBlock Text="{Binding [AchatBreadcrumb], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding [AchatPageSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource NeuButtonStyle}"
                        Background="{DynamicResource NeuAccentBrush}"
                        Foreground="White"
                        Padding="16,10"
                        FontWeight="SemiBold"
                        Command="{Binding AddAchatCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [AchatAddButton], Source={x:Static loc:LanguageManager.Instance}}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ─── Table card ─── -->
            <ContentControl Grid.Row="1"
                            Style="{StaticResource NeuDashCardStyle}"
                            Margin="8,0,8,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [AchatTableTitle], Source={x:Static loc:LanguageManager.Instance}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                            <TextBlock Text="{Binding [AchatTableSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                                       FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource NeuInputFillBrush}"
                                    CornerRadius="10" Padding="12,5" Margin="0,0,12,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource NeuAccentBrush}">
                                    <Run Text="{Binding Achats.Count, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding [AchatCountBadge], Source={x:Static loc:LanguageManager.Instance}, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Button Style="{StaticResource NeuButtonStyle}"
                                    Padding="10,8"
                                    Command="{Binding RefreshCommand}">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Column headers -->
                    <Grid Grid.Row="1" Margin="0,16,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [AchatColNumero],      Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource AchatColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding [AchatColDate],        Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource AchatColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="{Binding [AchatColFournisseur], Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource AchatColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="3" Text="{Binding [AchatColProduit],     Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource AchatColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="4" Text="{Binding [AchatColQuantite],    Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource AchatColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="5" Text="{Binding [AchatColCout],        Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource AchatColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="6" Text="{Binding [AchatColDefectueuse], Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource AchatColHeaderStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="{Binding [AchatColActions],     Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource AchatColHeaderStyle}" HorizontalAlignment="Center" />
                    </Grid>

                    <!-- Rows -->
                    <Grid Grid.Row="2" MinHeight="120">
                        <ItemsControl ItemsSource="{Binding Achats}"
                                      ItemTemplate="{StaticResource AchatRowTemplate}"
                                      AlternationCount="2" />

                        <!-- Loading overlay -->
                        <Border Background="#33000000" CornerRadius="8"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="40" Height="40"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource NeuAccentBrush}" />
                        </Border>

                        <!-- Empty state -->
                        <TextBlock Text="{Binding [AchatEmpty], Source={x:Static loc:LanguageManager.Instance}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,40,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource NeuTextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                                <Condition Binding="{Binding Achats.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>
    </ScrollViewer>

</UserControl>
