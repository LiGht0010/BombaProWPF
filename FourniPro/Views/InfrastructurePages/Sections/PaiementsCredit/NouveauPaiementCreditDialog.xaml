<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.PaiementsCredit.NouveauPaiementCreditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FourniPro.Localization"
                 xmlns:vm="clr-namespace:FourniPro.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:NouveauPaiementCreditViewModel}"
                 Title="{Binding [NouveauPcTitle], Source={x:Static loc:LanguageManager.Instance}}"
                 Width="900" Height="780"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource NeuBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <Style x:Key="DlgCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="20,18"/>
        </Style>
        <Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource NeuTextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DlgIconCircleStyle" TargetType="Border">
            <Setter Property="Width"   Value="28"/>
            <Setter Property="Height"  Value="28"/>
            <Setter Property="CornerRadius"  Value="14"/>
            <Setter Property="Background"    Value="{DynamicResource NeuInputFillBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"  Value="0,0,10,0"/>
        </Style>
        <Style x:Key="DlgLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="DlgInputBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="MinHeight"       Value="36"/>
        </Style>
        <Style x:Key="DlgInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource NeuTextPrimaryBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DlgFilePickerButtonStyle" TargetType="Button">
            <Setter Property="Background"        Value="{DynamicResource NeuAccentBrush}"/>
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="10,5"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgCloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"  Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource NeuAccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- Outer shell -->
    <Border CornerRadius="14"
            Background="{DynamicResource NeuBackgroundBrush}"
            BorderBrush="{DynamicResource NeuInputFillBrush}"
            BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Header ─── -->
            <Grid Grid.Row="0" Margin="22,18,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource DlgCloseButtonStyle}" Click="OnCancelClick">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding [NouveauPcTitle], Source={x:Static loc:LanguageManager.Instance}}"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource NeuJaugAccentBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>

                <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16"
                        Background="Transparent"
                        BorderBrush="{DynamicResource NeuInputFillBrush}" BorderThickness="1">
                    <ui:SymbolIcon Symbol="MoneyHand24" FontSize="14"
                                   Foreground="{DynamicResource NeuAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- ─── Body: 2×2 card grid ─── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,8,18,8">

                    <!-- Row 1: Identification | Commercial -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── Crédit & Date ── -->
                        <Border Grid.Column="0" Style="{StaticResource DlgCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauPcCardCredit], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}"/>
                                </StackPanel>

                                <!-- Crédit -->
                                <TextBlock Text="{Binding [NouveauPcCredit], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Credits}"
                                          SelectedItem="{Binding SelectedCredit, Mode=TwoWay}"
                                          Style="{DynamicResource NeuComboBoxStyle}"
                                          Margin="0,0,0,14">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding NumeroCredit}"/>
                                                <TextBlock Text=" — " Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ClientNom, TargetNullValue=''}"
                                                           Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Date -->
                                <TextBlock Text="{Binding [NouveauPcDate], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding DatePaiement, Mode=TwoWay}"
                                            Style="{DynamicResource NeuDatePickerStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Montant & Mode ── -->
                        <Border Grid.Column="2" Style="{StaticResource DlgCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Money24" FontSize="14"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauPcCardPaiement], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}"/>
                                </StackPanel>

                                <!-- Montant -->
                                <TextBlock Text="{Binding [NouveauPcMontant], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}"/>
                                <Border Style="{StaticResource DlgInputBorderStyle}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Montant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                 Style="{StaticResource DlgInputTextBoxStyle}"/>
                                        <TextBlock Grid.Column="1" Text="DH" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Mode de paiement -->
                                <TextBlock Text="{Binding [NouveauPcMode], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PaymentMethods}"
                                          SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                                          Style="{DynamicResource NeuComboBoxStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Employé | Références & Note -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── Employé ── -->
                        <Border Grid.Column="0" Style="{StaticResource DlgCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Person24" FontSize="14"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauPcCardEmploye], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding [NouveauPcEmploye], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Employes}"
                                          SelectedItem="{Binding SelectedEmploye, Mode=TwoWay}"
                                          Style="{DynamicResource NeuComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Prenom}"/>
                                                <TextBlock Text=" "/>
                                                <TextBlock Text="{Binding Nom}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- ── Référence & Note ── -->
                        <Border Grid.Column="2" Style="{StaticResource DlgCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Note24" FontSize="14"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauPcCardInfo], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}"/>
                                </StackPanel>

                                <!-- Référence -->
                                <TextBlock Text="{Binding [NouveauPcReference], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}"/>
                                <Border Style="{StaticResource DlgInputBorderStyle}" Margin="0,0,0,14">
                                    <TextBox Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DlgInputTextBoxStyle}"/>
                                </Border>

                                <!-- Fichier de référence -->
                                <TextBlock Text="{Binding [NouveauPcReferenceFile], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}"/>
                                <Border Style="{StaticResource DlgInputBorderStyle}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Filename when set -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ReferenceFile}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource NeuTextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReferenceFile}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Placeholder when null -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding [NouveauPcNoFile], Source={x:Static loc:LanguageManager.Instance}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReferenceFile}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource DlgFilePickerButtonStyle}"
                                                Command="{Binding BrowseReferenceFileCommand}"
                                                Margin="8,0,0,0">
                                            <ui:SymbolIcon Symbol="Attach24" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Note -->
                                <TextBlock Text="{Binding [NouveauPcNote], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}"/>
                                <Border Style="{StaticResource DlgInputBorderStyle}" MinHeight="72">
                                    <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             Style="{StaticResource DlgInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- ─── Footer ─── -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,1,0,0" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Error -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                                 Value="Visible">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="13"
                                       Foreground="{DynamicResource NeuDangerBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                                   Foreground="{DynamicResource NeuDangerBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource DlgSecondaryButtonStyle}" Margin="0,0,10,0"
                            Content="{Binding [NouveauPcCancel], Source={x:Static loc:LanguageManager.Instance}}"
                            Click="OnCancelClick"/>

                    <Button Grid.Column="2" Style="{StaticResource DlgPrimaryButtonStyle}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0">
                                <ui:ProgressRing.Style>
                                    <Style TargetType="ui:ProgressRing">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:ProgressRing.Style>
                            </ui:ProgressRing>
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="{Binding [NouveauPcSave], Source={x:Static loc:LanguageManager.Instance}}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>

</ui:FluentWindow>
