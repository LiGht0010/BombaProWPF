<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.Ventes.NouveauVenteDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FourniPro.Localization"
                 xmlns:vm="clr-namespace:FourniPro.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:NouveauVenteViewModel}"
                 Title="{Binding [NouveauVenteTitle], Source={x:Static loc:LanguageManager.Instance}}"
                 Width="900" Height="780"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource NeuBackgroundBrush}">

    <ui:FluentWindow.Resources>

        <!-- ─── Card surface (matches SaisirJaugeageGlobalDialog aesthetic) ─── -->
        <Style x:Key="DlgCardBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuBackgroundBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="12" />
            <Setter Property="Padding"         Value="20,18" />
        </Style>

        <Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DlgFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="Margin"     Value="0,0,0,6" />
        </Style>

        <Style x:Key="DlgInputBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="10,6" />
            <Setter Property="MinHeight"       Value="36" />
        </Style>

        <Style x:Key="DlgComputedBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="10,6" />
            <Setter Property="MinHeight"       Value="36" />
        </Style>

        <Style x:Key="DlgInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness"          Value="0" />
            <Setter Property="Background"               Value="Transparent" />
            <Setter Property="Foreground"               Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="FontSize"                 Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DlgIconCircleStyle" TargetType="Border">
            <Setter Property="Width"             Value="28" />
            <Setter Property="Height"            Value="28" />
            <Setter Property="CornerRadius"      Value="14" />
            <Setter Property="Background"        Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,10,0" />
        </Style>

        <Style x:Key="DlgCloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width"           Value="32" />
            <Setter Property="Height"          Value="32" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="20,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="14,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgFilePickerButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="10,6" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="MinHeight"       Value="36" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <!-- Outer shell -->
    <Border CornerRadius="14"
            Background="{DynamicResource NeuBackgroundBrush}"
            BorderBrush="{DynamicResource NeuInputFillBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Header ─── -->
            <Grid Grid.Row="0" Margin="22,18,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource DlgCloseButtonStyle}"
                        Click="OnCancelClick"
                        ToolTip="{Binding [NouveauVenteCancel], Source={x:Static loc:LanguageManager.Instance}}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding [NouveauVenteTitle], Source={x:Static loc:LanguageManager.Instance}}"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource NeuAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />

                <Border Grid.Column="2"
                        Width="32" Height="32" CornerRadius="16"
                        Background="Transparent"
                        BorderBrush="{DynamicResource NeuInputFillBrush}"
                        BorderThickness="1">
                    <ui:SymbolIcon Symbol="Receipt24" FontSize="14"
                                   Foreground="{DynamicResource NeuAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- ─── Body: 2 × 2 card grid ─── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,8,18,8">

                    <!-- Row 1: Identification (left) | Commercial (right) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ── Identification ── -->
                        <Border Grid.Column="0" Style="{StaticResource DlgCardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Info24" FontSize="14"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauVenteCardIdentification], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}" />
                                </StackPanel>

                                <TextBlock Text="{Binding [NouveauVenteDate], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgFieldLabelStyle}" />
                                <DatePicker SelectedDate="{Binding DateVente, Mode=TwoWay}"
                                            Style="{DynamicResource NeuDatePickerStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- ── Commercial ── -->
                        <Border Grid.Column="2" Style="{StaticResource DlgCardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Person24" FontSize="14"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauVenteCardCommercial], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}" />
                                </StackPanel>

                                <TextBlock Text="{Binding [NouveauVenteClient], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgFieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Clients}"
                                          SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                                          Style="{DynamicResource NeuComboBoxStyle}"
                                          Margin="0,0,0,14">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nom}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="{Binding [NouveauVenteProduit], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgFieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Produits}"
                                          SelectedItem="{Binding SelectedProduit, Mode=TwoWay}"
                                          Style="{DynamicResource NeuComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Financier (left) | Informations (right) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ── Financier ── -->
                        <Border Grid.Column="0" Style="{StaticResource DlgCardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Money24" FontSize="14"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauVenteCardFinancier], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}" />
                                </StackPanel>

                                <!-- Quantité / Prix unitaire -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [NouveauVenteQuantite], Source={x:Static loc:LanguageManager.Instance}}"
                                                   Style="{StaticResource DlgFieldLabelStyle}" />
                                        <Border Style="{StaticResource DlgInputBorderStyle}">
                                            <TextBox Text="{Binding Quantite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     Style="{StaticResource DlgInputTextBoxStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding [NouveauVentePrixUnitaire], Source={x:Static loc:LanguageManager.Instance}}"
                                                   Style="{StaticResource DlgFieldLabelStyle}" />
                                        <Border Style="{StaticResource DlgInputBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding PrixUnitaire, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         Style="{StaticResource DlgInputTextBoxStyle}" />
                                                <TextBlock Grid.Column="1" Text="DH"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Remise / Montant total -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [NouveauVenteRemise], Source={x:Static loc:LanguageManager.Instance}}"
                                                   Style="{StaticResource DlgFieldLabelStyle}" />
                                        <Border Style="{StaticResource DlgInputBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Remise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         Style="{StaticResource DlgInputTextBoxStyle}" />
                                                <TextBlock Grid.Column="1" Text="%"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding [NouveauVenteMontantTotal], Source={x:Static loc:LanguageManager.Instance}}"
                                                   Style="{StaticResource DlgFieldLabelStyle}" />
                                        <Border Style="{StaticResource DlgComputedBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding MontantTotal, StringFormat=N2, TargetNullValue='—'}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NeuAccentBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="DH"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Mode de paiement -->
                                <TextBlock Text="{Binding [NouveauVentePaymentMethod], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgFieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding PaymentMethods}"
                                          SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                                          Style="{DynamicResource NeuComboBoxStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- ── Informations ── -->
                        <Border Grid.Column="2" Style="{StaticResource DlgCardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Note24" FontSize="14"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauVenteCardInformations], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}" />
                                </StackPanel>

                                <!-- Référence -->
                                <TextBlock Text="{Binding [NouveauVenteReference], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgFieldLabelStyle}" />
                                <Border Style="{StaticResource DlgInputBorderStyle}" Margin="0,0,0,14">
                                    <TextBox Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DlgInputTextBoxStyle}" />
                                </Border>

                                <!-- Fichier référence — file picker -->
                                <TextBlock Text="{Binding [NouveauVenteReferenceFile], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgFieldLabelStyle}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource DlgInputBorderStyle}">
                                        <TextBlock Text="{Binding ReferenceFile, TargetNullValue='—'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ReferenceFile}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource DlgFilePickerButtonStyle}"
                                            Command="{Binding BrowseReferenceFileCommand}"
                                            ToolTip="Parcourir…">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Attach24" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="Parcourir" FontSize="12"
                                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Note -->
                                <TextBlock Text="{Binding [NouveauVenteNote], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgFieldLabelStyle}" />
                                <Border Style="{StaticResource DlgInputBorderStyle}" MinHeight="80">
                                    <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             Style="{StaticResource DlgInputTextBoxStyle}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- ─── Footer ─── -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Error (left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                                 Value="Visible">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="13"
                                       Foreground="{DynamicResource NeuDangerBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource NeuDangerBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource DlgSecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Content="{Binding [NouveauVenteCancel], Source={x:Static loc:LanguageManager.Instance}}"
                            Click="OnCancelClick" />

                    <Button Grid.Column="2"
                            Style="{StaticResource DlgPrimaryButtonStyle}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0">
                                <ui:ProgressRing.Style>
                                    <Style TargetType="ui:ProgressRing">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:ProgressRing.Style>
                            </ui:ProgressRing>
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="{Binding [NouveauVenteSave], Source={x:Static loc:LanguageManager.Instance}}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
