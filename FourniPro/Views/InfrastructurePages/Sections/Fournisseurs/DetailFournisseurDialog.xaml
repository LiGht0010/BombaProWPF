<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.Fournisseurs.DetailFournisseurDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FourniPro.Localization"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="{Binding [DetailFourTitle], Source={x:Static loc:LanguageManager.Instance}}"
                 Width="560" Height="780"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource NeuBackgroundBrush}">

    <ui:FluentWindow.Resources>

        <Style x:Key="DlgCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuBackgroundBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="12" />
            <Setter Property="Padding"         Value="20,18" />
            <Setter Property="Margin"          Value="0,0,0,12" />
        </Style>

        <Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DlgIconCircleStyle" TargetType="Border">
            <Setter Property="Width"             Value="28" />
            <Setter Property="Height"            Value="28" />
            <Setter Property="CornerRadius"      Value="14" />
            <Setter Property="Background"        Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,10,0" />
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="Margin"     Value="0,0,0,4" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13" />
            <Setter Property="Foreground"   Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DetailAccentValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
        </Style>

        <Style x:Key="DlgCloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width"           Value="32" />
            <Setter Property="Height"          Value="32" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="14,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="20,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <Border CornerRadius="14"
            Background="{DynamicResource NeuBackgroundBrush}"
            BorderBrush="{DynamicResource NeuInputFillBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Header ─── -->
            <Grid Grid.Row="0" Margin="22,18,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource DlgCloseButtonStyle}"
                        Click="OnCloseClick">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <ui:SymbolIcon Symbol="People24" FontSize="18"
                                   Foreground="{DynamicResource NeuAccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <!-- Société or full name as heading -->
                        <TextBlock FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource NeuAccentBrush}"
                                   Text="{Binding DisplayName}" />
                        <TextBlock Text="{Binding [DetailFourTitle], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ─── Scrollable content ─── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,0">
                <StackPanel>

                    <!-- ── Card 1: Informations générales ── -->
                    <Border Style="{StaticResource DlgCardStyle}" Margin="0,8,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="13"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [DetailFourInfoSection], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                            </StackPanel>

                            <!-- Prénom + Nom (inline) -->
                            <TextBlock Text="{Binding [DetailFourLabelPrenom], Source={x:Static loc:LanguageManager.Instance}}"
                                       Style="{StaticResource DetailLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DetailValueStyle}"
                                           Text="{Binding Prenom, TargetNullValue='—', FallbackValue='—'}" />
                                <TextBlock Style="{StaticResource DetailValueStyle}"
                                           Text="{Binding Nom, TargetNullValue='', FallbackValue=''}"
                                           Margin="6,0,0,0" />
                            </StackPanel>

                            <!-- Société | Statut -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailFourLabelSociete], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Style="{StaticResource DetailAccentValueStyle}"
                                               Text="{Binding Societe, TargetNullValue='—', FallbackValue='—'}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />
                                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [DetailFourLabelStatut], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <!-- Active / inactive badge -->
                                    <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1F3FD46A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Inactif">
                                                        <Setter Property="Background" Value="#1FE05555" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#3FD46A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Statut}" Value="Inactif">
                                                                <Setter Property="Fill" Value="#E05555" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"       Value="{Binding [FourBadgeActif],   Source={x:Static loc:LanguageManager.Instance}}" />
                                                        <Setter Property="Foreground" Value="#3FD46A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Statut}" Value="Inactif">
                                                                <Setter Property="Text"       Value="{Binding [FourBadgeInactif], Source={x:Static loc:LanguageManager.Instance}}" />
                                                                <Setter Property="Foreground" Value="#E05555" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 2: Contact & coordonnées ── -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Call24" FontSize="13"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [DetailFourContactSection], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                            </StackPanel>

                            <!-- Téléphone | Email -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailFourLabelTelephone], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Style="{StaticResource DetailValueStyle}"
                                               Text="{Binding Telephone, TargetNullValue='—', FallbackValue='—'}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailFourLabelEmail], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Style="{StaticResource DetailValueStyle}"
                                               Text="{Binding Email, TargetNullValue='—', FallbackValue='—'}" />
                                </StackPanel>
                            </Grid>

                            <!-- Personne de contact -->
                            <TextBlock Text="{Binding [DetailFourLabelContact], Source={x:Static loc:LanguageManager.Instance}}"
                                       Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       Margin="0,0,0,14"
                                       Text="{Binding Contact, TargetNullValue='—', FallbackValue='—'}" />

                            <!-- Adresse -->
                            <TextBlock Text="{Binding [DetailFourLabelAdresse], Source={x:Static loc:LanguageManager.Instance}}"
                                       Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       Text="{Binding Adresse, TargetNullValue='—', FallbackValue='—'}" />
                        </StackPanel>
                    </Border>

                    <!-- ── Card 3: Finances & conditions ── -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Money24" FontSize="13"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [DetailFourFinanceSection], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                            </StackPanel>

                            <!-- RIB | Conditions paiement -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailFourLabelRIB], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Style="{StaticResource DetailValueStyle}"
                                               Text="{Binding RIB, TargetNullValue='—', FallbackValue='—'}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailFourLabelConditions], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Style="{StaticResource DetailValueStyle}"
                                               Text="{Binding ConditionsPaiement, TargetNullValue='—', FallbackValue='—'}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 4: Historique ── -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="History24" FontSize="13"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [DetailFourAuditSection], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Créé par -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailFourLabelCreePar], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Style="{StaticResource DetailAccentValueStyle}"
                                               Text="{Binding AjouteParNom, TargetNullValue='—', FallbackValue='—'}" />
                                    <TextBlock Style="{StaticResource DetailValueStyle}"
                                               FontSize="11"
                                               Text="{Binding DateCreation, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='—'}" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />

                                <!-- Modifié par -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailFourLabelModifiePar], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Style="{StaticResource DetailAccentValueStyle}"
                                               Text="{Binding ModifieParNom, TargetNullValue='—', FallbackValue='—'}" />
                                    <TextBlock Style="{StaticResource DetailValueStyle}"
                                               FontSize="11"
                                               Text="{Binding DateModification, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='—'}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ─── Footer ─── -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="22,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DlgSecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Content="{Binding [DetailFourClose], Source={x:Static loc:LanguageManager.Instance}}"
                            Click="OnCloseClick" />
                    <Button Style="{StaticResource DlgPrimaryButtonStyle}"
                            Click="OnEditClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [DetailFourEditButton], Source={x:Static loc:LanguageManager.Instance}, StringFormat='  {0}'}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</ui:FluentWindow>
