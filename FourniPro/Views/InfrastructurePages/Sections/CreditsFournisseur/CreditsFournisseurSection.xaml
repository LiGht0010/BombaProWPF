<UserControl x:Class="FourniPro.Views.InfrastructurePages.Sections.CreditsFournisseur.CreditsFournisseurSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FourniPro.Localization"
             xmlns:vm="clr-namespace:FourniPro.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CreditsFournisseurSectionViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="CfIconBtnStyle" TargetType="Button">
            <Setter Property="Width"  Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource NeuActionIconBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent"
                                BorderThickness="1" BorderBrush="{DynamicResource NeuActionBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuActionHoverFillBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CfDeleteBtnStyle" TargetType="Button">
            <Setter Property="Width"  Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource NeuDangerBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent"
                                BorderThickness="1" BorderBrush="{DynamicResource NeuActionDeleteBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuDangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CfColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CfCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="12" />
            <Setter Property="Foreground"    Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"  Value="CharacterEllipsis" />
        </Style>

        <!-- Row template -->
        <DataTemplate x:Key="CfRowTemplate">
            <Border Padding="0,10" BorderBrush="{DynamicResource NeuInputFillBrush}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" /><!-- Numéro -->
                        <ColumnDefinition Width="85"  /><!-- Date -->
                        <ColumnDefinition Width="*"   /><!-- Fournisseur -->
                        <ColumnDefinition Width="120" /><!-- Achat -->
                        <ColumnDefinition Width="*"   /><!-- Employé -->
                        <ColumnDefinition Width="100" /><!-- Montant -->
                        <ColumnDefinition Width="80"  /><!-- Statut -->
                        <ColumnDefinition Width="70"  /><!-- Chèque -->
                        <ColumnDefinition Width="96"  /><!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Numéro badge -->
                    <Border Grid.Column="0" Background="{DynamicResource NeuInputFillBrush}"
                            CornerRadius="6" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NumeroCreditF}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                    </Border>

                    <!-- Date -->
                    <TextBlock Grid.Column="1" Text="{Binding DateCredit, StringFormat=dd/MM/yyyy}"
                               Style="{StaticResource CfCellStyle}" HorizontalAlignment="Left" />

                    <!-- Fournisseur -->
                    <TextBlock Grid.Column="2" Text="{Binding FournisseurNom, TargetNullValue='—'}"
                               Style="{StaticResource CfCellStyle}" HorizontalAlignment="Left" />

                    <!-- Achat -->
                    <TextBlock Grid.Column="3" Text="{Binding AchatNumero, TargetNullValue='—'}"
                               Style="{StaticResource CfCellStyle}" HorizontalAlignment="Left" />

                    <!-- Employé -->
                    <TextBlock Grid.Column="4" Text="{Binding EmployeNom, TargetNullValue='—'}"
                               Style="{StaticResource CfCellStyle}" HorizontalAlignment="Left" />

                    <!-- Montant total -->
                    <TextBlock Grid.Column="5" Style="{StaticResource CfCellStyle}"
                               Foreground="{DynamicResource NeuAccentBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Left">
                        <Run Text="{Binding MontantTotal, StringFormat='{}{0:N2}', TargetNullValue='—'}" />
                        <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" FontWeight="Normal" />
                    </TextBlock>

                    <!-- Statut badge -->
                    <Border Grid.Column="6" CornerRadius="6" Padding="7,3"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Statut}" Value="Payé">
                                        <Setter Property="Background" Value="#1A22C55E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Statut}" Value="PartielPayé">
                                        <Setter Property="Background" Value="#1AF59E0B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Statut}" Value="NonPayé">
                                        <Setter Property="Background" Value="#1AEF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Statut, TargetNullValue='—'}"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Statut}" Value="Payé">
                                            <Setter Property="Foreground" Value="#22C55E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Statut}" Value="PartielPayé">
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Statut}" Value="NonPayé">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Chèque icon -->
                    <ui:SymbolIcon Grid.Column="7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="15">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol"     Value="Prohibited24" />
                                <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
                                <Setter Property="Opacity"    Value="0.4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChequeReference, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                        <Setter Property="Symbol"     Value="DocumentCheckmark24" />
                                        <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
                                        <Setter Property="Opacity"    Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <!-- Actions -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource CfIconBtnStyle}"
                                ToolTip="{Binding [CreditFournisseurDetailTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                                Command="{Binding DataContext.DetailCreditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Eye24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource CfIconBtnStyle}" Margin="4,0,0,0"
                                ToolTip="{Binding [CreditFournisseurEditTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                                Command="{Binding DataContext.EditCreditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource CfDeleteBtnStyle}" Margin="4,0,0,0"
                                ToolTip="{Binding [CreditFournisseurDeleteTooltip], Source={x:Static loc:LanguageManager.Instance}}"
                                Command="{Binding DataContext.DeleteCreditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Header ─── -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [ProdBreadcrumbInfra], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                        <TextBlock Text=" › " FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                        <TextBlock Text="{Binding [CreditFournisseurBreadcrumb], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding [CreditFournisseurPageSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource NeuButtonStyle}"
                        Background="{DynamicResource NeuAccentBrush}"
                        Foreground="White" Padding="16,10" FontWeight="SemiBold"
                        Command="{Binding AddCreditCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [CreditFournisseurAddButton], Source={x:Static loc:LanguageManager.Instance}}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ─── Table card ─── -->
            <ContentControl Grid.Row="1" Style="{StaticResource NeuDashCardStyle}" Margin="8,0,8,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [CreditFournisseurTableTitle], Source={x:Static loc:LanguageManager.Instance}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                            <TextBlock Text="{Binding [CreditFournisseurTableSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                                       FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource NeuInputFillBrush}"
                                    CornerRadius="10" Padding="12,5" Margin="0,0,12,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource NeuAccentBrush}">
                                    <Run Text="{Binding Credits.Count, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding [CreditFournisseurCountBadge], Source={x:Static loc:LanguageManager.Instance}, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Button Style="{StaticResource NeuButtonStyle}" Padding="10,8"
                                    Command="{Binding RefreshCommand}">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Column headers -->
                    <Grid Grid.Row="1" Margin="0,16,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="85"  />
                            <ColumnDefinition Width="*"   />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*"   />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80"  />
                            <ColumnDefinition Width="70"  />
                            <ColumnDefinition Width="96"  />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [CreditFournisseurColNumero],     Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CfColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding [CreditFournisseurColDate],       Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CfColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="{Binding [CreditFournisseurColFournisseur],Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CfColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="3" Text="{Binding [CreditFournisseurColAchat],      Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CfColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="4" Text="{Binding [CreditFournisseurColEmploye],    Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CfColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="5" Text="{Binding [CreditFournisseurColMontant],    Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CfColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="6" Text="{Binding [CreditFournisseurColStatut],     Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CfColHeaderStyle}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="7" Text="{Binding [CreditFournisseurColCheque],     Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CfColHeaderStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="8" Text="{Binding [CreditFournisseurColActions],    Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource CfColHeaderStyle}" HorizontalAlignment="Center" />
                    </Grid>

                    <!-- Rows -->
                    <Grid Grid.Row="2" MinHeight="120">
                        <ItemsControl ItemsSource="{Binding Credits}"
                                      ItemTemplate="{StaticResource CfRowTemplate}"
                                      AlternationCount="2" />

                        <!-- Loading overlay -->
                        <Border Background="#33000000" CornerRadius="8"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{DynamicResource NeuAccentBrush}" />
                        </Border>

                        <!-- Empty state -->
                        <TextBlock Text="{Binding [CreditFournisseurEmpty], Source={x:Static loc:LanguageManager.Instance}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,40,0,0" FontSize="13"
                                   Foreground="{DynamicResource NeuTextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsLoading}"   Value="False" />
                                                <Condition Binding="{Binding Credits.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>
    </ScrollViewer>

</UserControl>
