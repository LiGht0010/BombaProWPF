<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.Produits.NouveauProduitDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FourniPro.Localization"
                 xmlns:vm="clr-namespace:FourniPro.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:NouveauProduitViewModel}"
                 Title="{Binding [NouveauProdTitle], Source={x:Static loc:LanguageManager.Instance}}"
                 Width="640" Height="720"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource NeuBackgroundBrush}">

    <ui:FluentWindow.Resources>

        <!-- ── Card wrapper ── -->
        <Style x:Key="DlgCardStyle" TargetType="Border">
            <Setter Property="Background"        Value="{DynamicResource NeuBackgroundBrush}" />
            <Setter Property="BorderBrush"       Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness"   Value="1" />
            <Setter Property="CornerRadius"      Value="12" />
            <Setter Property="Padding"           Value="20,18" />
            <Setter Property="Margin"            Value="0,0,0,12" />
        </Style>

        <!-- ── Section title inside a card ── -->
        <Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ── Field label ── -->
        <Style x:Key="DlgLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="Margin"     Value="0,0,0,5" />
        </Style>

        <!-- ── Editable input wrapper ── -->
        <Style x:Key="DlgInputBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="10,6" />
            <Setter Property="MinHeight"       Value="36" />
        </Style>

        <!-- ── Plain TextBox inside input border ── -->
        <Style x:Key="DlgTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness"        Value="0" />
            <Setter Property="Background"             Value="Transparent" />
            <Setter Property="Foreground"             Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="FontSize"               Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ── Read-only computed value (accent tint) ── -->
        <Style x:Key="DlgComputedBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuJaugAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="10,6" />
            <Setter Property="MinHeight"       Value="36" />
        </Style>

        <!-- ── Small icon circle ── -->
        <Style x:Key="DlgIconCircleStyle" TargetType="Border">
            <Setter Property="Width"           Value="28" />
            <Setter Property="Height"          Value="28" />
            <Setter Property="CornerRadius"    Value="14" />
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"          Value="0,0,10,0" />
        </Style>

        <!-- ── Primary (accent) button ── -->
        <Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"    Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="Foreground"    Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"       Value="20,10" />
            <Setter Property="FontSize"      Value="13" />
            <Setter Property="FontWeight"    Value="SemiBold" />
            <Setter Property="Cursor"        Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary (ghost) button ── -->
        <Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"    Value="Transparent" />
            <Setter Property="Foreground"    Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"       Value="14,10" />
            <Setter Property="FontSize"      Value="13" />
            <Setter Property="FontWeight"    Value="SemiBold" />
            <Setter Property="Cursor"        Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dismiss button ── -->
        <Style x:Key="DlgCloseButtonStyle" TargetType="Button">
            <Setter Property="Background"    Value="Transparent" />
            <Setter Property="Foreground"    Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width"         Value="32" />
            <Setter Property="Height"        Value="32" />
            <Setter Property="Cursor"        Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <!-- ═══ Outer card shell ═══ -->
    <Border CornerRadius="14"
            Background="{DynamicResource NeuBackgroundBrush}"
            BorderBrush="{DynamicResource NeuInputFillBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Header ─── -->
            <Grid Grid.Row="0" Margin="18,16,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource DlgCloseButtonStyle}"
                        Click="OnCancelClick">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                    <ui:SymbolIcon Symbol="Box24" FontSize="18"
                                   Foreground="{DynamicResource NeuAccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding [NouveauProdTitle], Source={x:Static loc:LanguageManager.Instance}}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource NeuAccentBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ─── Scrollable form ─── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="18,4,18,0">
                <StackPanel>

                    <!-- ── Card 1: Informations générales ── -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <!-- Section title -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="13"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [NouveauProdInfoSection], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                            </StackPanel>

                            <!-- Numéro -->
                            <TextBlock Text="{Binding [NouveauProdLabelNumero], Source={x:Static loc:LanguageManager.Instance}}"
                                       Style="{StaticResource DlgLabelStyle}" />
                            <Border Style="{StaticResource DlgInputBorderStyle}" Margin="0,0,0,14">
                                <TextBox Text="{Binding Numero, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DlgTextBoxStyle}" />
                            </Border>

                            <!-- Description -->
                            <TextBlock Text="{Binding [NouveauProdLabelDescription], Source={x:Static loc:LanguageManager.Instance}}"
                                       Style="{StaticResource DlgLabelStyle}" />
                            <Border Style="{StaticResource DlgInputBorderStyle}">
                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DlgTextBoxStyle}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 2: Tarification ── -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <!-- Section title -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Money24" FontSize="13"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [NouveauProdPricingSection], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                            </StackPanel>

                            <!-- Row 1: Prix achat | Prix HT -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [NouveauProdLabelPrixAchat], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgLabelStyle}" />
                                    <Border Style="{StaticResource DlgInputBorderStyle}">
                                        <TextBox Text="{Binding PrixAchatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DlgTextBoxStyle}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [NouveauProdLabelPrixHT], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgLabelStyle}" />
                                    <Border Style="{StaticResource DlgInputBorderStyle}">
                                        <TextBox Text="{Binding PrixHtText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DlgTextBoxStyle}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: TVA | Prix TTC -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [NouveauProdLabelTVA], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgLabelStyle}" />
                                    <Border Style="{StaticResource DlgInputBorderStyle}">
                                        <TextBox Text="{Binding TvaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DlgTextBoxStyle}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [NouveauProdLabelPrixTTC], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgLabelStyle}" />
                                    <Border Style="{StaticResource DlgInputBorderStyle}">
                                        <TextBox Text="{Binding PrixTtcText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DlgTextBoxStyle}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Marge DH (computed, read-only) -->
                            <TextBlock Text="{Binding [NouveauProdLabelMarge], Source={x:Static loc:LanguageManager.Instance}}"
                                       Style="{StaticResource DlgLabelStyle}" />
                            <Border Style="{StaticResource DlgComputedBorderStyle}" Margin="0,0,0,12">
                                <TextBlock Text="{Binding Marge, StringFormat='{}{0:F2} DH', TargetNullValue='— DH'}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource NeuAccentBrush}"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Row 4: Marge % pill -->
                            <Border Background="{DynamicResource NeuInputFillBrush}"
                                    CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowTrending24" FontSize="14"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Marge %"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MargePct, StringFormat='{}{0:F1} %', TargetNullValue='— %'}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource NeuAccentBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 3: Stock & logistique ── -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <!-- Section title -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Stack24" FontSize="13"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [NouveauProdStockSection], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Stock initial -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [NouveauProdLabelStock], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgLabelStyle}" />
                                    <Border Style="{StaticResource DlgInputBorderStyle}">
                                        <TextBox Text="{Binding StockText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DlgTextBoxStyle}" />
                                    </Border>
                                </StackPanel>

                                <!-- Stock minimum -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [NouveauProdLabelStockMin], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgLabelStyle}" />
                                    <Border Style="{StaticResource DlgInputBorderStyle}">
                                        <TextBox Text="{Binding StockMinText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DlgTextBoxStyle}" />
                                    </Border>
                                </StackPanel>

                                <!-- Délai livraison -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{Binding [NouveauProdLabelDelai], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgLabelStyle}" />
                                    <Border Style="{StaticResource DlgInputBorderStyle}">
                                        <TextBox Text="{Binding DelaiText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DlgTextBoxStyle}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ─── Footer ─── -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Error toast (left) -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource NeuDangerBrush}"
                            Opacity="0.92"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="13"
                                           Foreground="White" VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="12" Foreground="White"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Cancel -->
                    <Button Grid.Column="1"
                            Style="{StaticResource DlgSecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Content="{Binding [NouveauProdCancel], Source={x:Static loc:LanguageManager.Instance}}"
                            Click="OnCancelClick" />

                    <!-- Save -->
                    <Button Grid.Column="2"
                            Style="{StaticResource DlgPrimaryButtonStyle}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing Width="14" Height="14"
                                             IsIndeterminate="True"
                                             Foreground="White"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ui:SymbolIcon Symbol="Save24" FontSize="14"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsSaving, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding [NouveauProdSave], Source={x:Static loc:LanguageManager.Instance}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Text" Value="{Binding [NouveauProdSaving], Source={x:Static loc:LanguageManager.Instance}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</ui:FluentWindow>
