<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.Voyages.DetailVoyageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FourniPro.Localization"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="{Binding [DetailVoyageTitle], Source={x:Static loc:LanguageManager.Instance}}"
                 Width="900" Height="720"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource NeuBackgroundBrush}">

    <ui:FluentWindow.Resources>

        <Style x:Key="DlgCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuBackgroundBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="12" />
            <Setter Property="Padding"         Value="20,18" />
            <Setter Property="Margin"          Value="0,0,0,12" />
        </Style>

        <Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DlgIconCircleStyle" TargetType="Border">
            <Setter Property="Width"             Value="28" />
            <Setter Property="Height"            Value="28" />
            <Setter Property="CornerRadius"      Value="14" />
            <Setter Property="Background"        Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,10,0" />
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="Margin"     Value="0,0,0,4" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13" />
            <Setter Property="Foreground"   Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DetailAccentValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
        </Style>

        <Style x:Key="DlgCloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width"           Value="32" />
            <Setter Property="Height"          Value="32" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="14,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="20,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <!-- Outer shell -->
    <Border CornerRadius="14"
            Background="{DynamicResource NeuBackgroundBrush}"
            BorderBrush="{DynamicResource NeuInputFillBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- â”€â”€â”€ Header â”€â”€â”€ -->
            <Grid Grid.Row="0" Margin="22,18,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource DlgCloseButtonStyle}" Click="OnCloseClick">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <ui:SymbolIcon Symbol="VehicleTruck24" FontSize="18"
                                   Foreground="{DynamicResource NeuAccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [DetailVoyageTitle], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource NeuJaugAccentBrush}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}">
                            <Run Text="VOY-" /><Run Text="{Binding Voyage.VoyageId, StringFormat={}{0:D5}}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- â”€â”€â”€ Scrollable content â”€â”€â”€ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,0">
                <StackPanel>

                    <!-- â”€â”€ Card 1 : Identification â”€â”€ -->
                    <Border Style="{StaticResource DlgCardStyle}" Margin="0,8,0,12">
                        <StackPanel>

                            <!-- Card header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [DetailVoyageCardIdentification], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                            </StackPanel>

                            <!-- Row 1 : NumÃ©ro | Statut -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelNumero], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource NeuTextPrimaryBrush}">
                                        <Run Text="VOY-" /><Run Text="{Binding Voyage.VoyageId, StringFormat={}{0:D5}}" />
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelStatut], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <!-- Statut pill -->
                                    <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Voyage.Statut}" Value="Completed">
                                                        <Setter Property="Background" Value="{DynamicResource NeuJaugAccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Voyage.Statut}" Value="Cancelled">
                                                        <Setter Property="Background" Value="{DynamicResource NeuDangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Voyage.Statut}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Voyage.Statut}" Value="Completed">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Voyage.Statut}" Value="Cancelled">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2 : Chauffeur | Camion -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelChauffeur], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding Voyage.ChauffeurNom, TargetNullValue='â€”'}"
                                               Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelCamion], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding Voyage.CamionMatricule, TargetNullValue='â€”'}"
                                               Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 3 : Citerne | (empty) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelCiterne], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding Voyage.CiterneMatricule, TargetNullValue='â€”'}"
                                               Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" />
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- â”€â”€ Card 2 : ItinÃ©raire & KilomÃ©trage â”€â”€ -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>

                            <!-- Card header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Map24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [DetailVoyageCardItineraire], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                            </StackPanel>

                            <!-- Row 1 : Date dÃ©part | Date arrivÃ©e -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelDateDepart], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding Voyage.DateDepart, StringFormat=dd/MM/yyyy, TargetNullValue='â€”'}"
                                               Style="{StaticResource DetailValueStyle}" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelDateFinal], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding Voyage.DateFinal, StringFormat=dd/MM/yyyy, TargetNullValue='â€”'}"
                                               Style="{StaticResource DetailValueStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2 : Lieu dÃ©part | Lieu terminal -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelLieuDepart], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding Voyage.LieuDepart, TargetNullValue='â€”'}"
                                               Style="{StaticResource DetailValueStyle}" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelLieuTerminal], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding Voyage.LieuTerminal, TargetNullValue='â€”'}"
                                               Style="{StaticResource DetailValueStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 3 : KM dÃ©part | KM arrivÃ©e -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelKmDepart], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Style="{StaticResource DetailAccentValueStyle}">
                                        <Run Text="{Binding Voyage.KilometrageDepart, StringFormat={}{0:N0}, TargetNullValue='â€”'}" />
                                        <Run Text=" km" Foreground="{DynamicResource NeuTextSecondaryBrush}" FontSize="12" FontWeight="Normal" />
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailVoyageLabelKmFinal], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Style="{StaticResource DetailAccentValueStyle}">
                                        <Run Text="{Binding Voyage.KilometrageFinal, StringFormat={}{0:N0}, TargetNullValue='â€”'}" />
                                        <Run Text=" km" Foreground="{DynamicResource NeuTextSecondaryBrush}" FontSize="12" FontWeight="Normal" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Prix pill : Distance parcourue -->
                            <Border Background="{DynamicResource NeuInputFillBrush}" CornerRadius="10" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [DetailVoyageLabelDistance], Source={x:Static loc:LanguageManager.Instance}}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                        <TextBlock Text="KilomÃ©trage total du trajet"
                                                   FontSize="11" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource NeuTextPrimaryBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="â€”" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Voyage.KilometrageDepart, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible" />
                                                            <Condition Binding="{Binding Voyage.KilometrageFinal,  Converter={StaticResource NullToVisibilityConverter}}" Value="Visible" />
                                                        </MultiDataTrigger.Conditions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Voyage.DistanceParcourue, StringFormat={}{0:N0}, TargetNullValue='â€”', Mode=OneWay}" />
                                        <Run Text=" km" Foreground="{DynamicResource NeuTextSecondaryBrush}" FontSize="13" FontWeight="Normal" />
                                    </TextBlock>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- ── Card 3 : Ventes ── -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Tag24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [NouveauVoyageTabVente], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                                <Border Background="{DynamicResource NeuInputFillBrush}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Ventes.Count, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="DATE"      FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="CLIENT"    FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="PRODUIT"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="QTE"       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="PAIEMENT"  FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="MONTANT"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Background="{DynamicResource NeuInputFillBrush}" Height="1" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Ventes}" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,9,0,9" BorderBrush="{DynamicResource NeuInputFillBrush}" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DateVente, StringFormat={}{0:dd/MM/yy}}" FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ClientNom,   TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding ProduitNom,  TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Quantite,    TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding PaymentMethod, TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}" VerticalAlignment="Center">
                                                    <Run Text="{Binding MontantTotal, StringFormat={}{0:N2}, TargetNullValue='—', Mode=OneWay}" />
                                                    <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 4 : Crédits ── -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Money24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [NouveauVoyageTabCredit], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                                <Border Background="{DynamicResource NeuInputFillBrush}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Credits.Count, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="DATE"      FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="CLIENT"    FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="PRODUIT"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="QTE"       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="STATUT"    FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="MONTANT"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Background="{DynamicResource NeuInputFillBrush}" Height="1" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Credits}" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,9,0,9" BorderBrush="{DynamicResource NeuInputFillBrush}" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DateCredit, StringFormat={}{0:dd/MM/yy}}" FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ClientNom,  TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding ProduitNom, TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Quantite,   TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Statut,     TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}" VerticalAlignment="Center">
                                                    <Run Text="{Binding MontantTotal, StringFormat={}{0:N2}, TargetNullValue='—', Mode=OneWay}" />
                                                    <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 5 : Stock Voyage ── -->
                    <Border Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Box24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [NouveauVoyageColStock], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                                <Border Background="{DynamicResource NeuInputFillBrush}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stocks.Count, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="PRODUIT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="QTE"     FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" HorizontalAlignment="Center" />
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource NeuInputFillBrush}" Height="1" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Stocks}" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,9,0,9" BorderBrush="{DynamicResource NeuInputFillBrush}" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ProduitNom, TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Quantite,   TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 6 : Frais Voyage ── -->
                    <Border Style="{StaticResource DlgCardStyle}" Margin="0,0,0,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Receipt24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [NouveauVoyageTabFrais], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}" />
                                <Border Background="{DynamicResource NeuInputFillBrush}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Frais.Count, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="TYPE"        FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="DESCRIPTION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="MONTANT"     FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" Padding="0,0,0,6" />
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource NeuInputFillBrush}" Height="1" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Frais}" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,9,0,9" BorderBrush="{DynamicResource NeuInputFillBrush}" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Type,        TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Description, TargetNullValue='—'}" FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}"   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NeuDangerBrush}" VerticalAlignment="Center">
                                                    <Run Text="{Binding Montant, StringFormat={}{0:N2}, TargetNullValue='—', Mode=OneWay}" />
                                                    <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- â”€â”€â”€ Footer â”€â”€â”€ -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NeuInputFillBrush}" Padding="22,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DlgSecondaryButtonStyle}" Click="OnCloseClick" Margin="0,0,8,0">
                        <TextBlock Text="{Binding [DetailVoyageCloseButton], Source={x:Static loc:LanguageManager.Instance}}" />
                    </Button>
                    <Button Style="{StaticResource DlgPrimaryButtonStyle}" Click="OnEditClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [DetailVoyageEditButton], Source={x:Static loc:LanguageManager.Instance}}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</ui:FluentWindow>

