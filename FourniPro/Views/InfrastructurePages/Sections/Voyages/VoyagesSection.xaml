<UserControl x:Class="FourniPro.Views.InfrastructurePages.Sections.Voyages.VoyagesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FourniPro.Localization"
             xmlns:vm="clr-namespace:FourniPro.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VoyagesSectionViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="VoyageDeleteBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource NeuDangerBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent"
                                BorderThickness="1" BorderBrush="{DynamicResource NeuActionDeleteBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuDangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="VoyageRowTemplate">
            <Border Padding="0,10,0,10"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CamionMatricule,  TargetNullValue=_}" Style="{StaticResource CellTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding ChauffeurNom,     TargetNullValue=_}" Style="{StaticResource CellTextStyle}" />
                    <TextBlock Grid.Column="2" Text="{Binding CiterneMatricule, TargetNullValue=_}" Style="{StaticResource CellTextStyle}" />
                    <TextBlock Grid.Column="3" Text="{Binding DateDepart,       StringFormat=dd/MM/yyyy, TargetNullValue=_}" Style="{StaticResource CellTextStyle}" />
                    <TextBlock Grid.Column="4" Text="{Binding DateFinal,        StringFormat=dd/MM/yyyy, TargetNullValue=_}" Style="{StaticResource CellTextStyle}" />
                    <TextBlock Grid.Column="5" Text="{Binding LieuDepart,       TargetNullValue=_}" Style="{StaticResource CellTextStyle}" />
                    <TextBlock Grid.Column="6" Text="{Binding LieuTerminal,     TargetNullValue=_}" Style="{StaticResource CellTextStyle}" />
                    <Border Grid.Column="7" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Statut}" Value="Completed">
                                        <Setter Property="Background" Value="{DynamicResource NeuJaugAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Statut}" Value="Cancelled">
                                        <Setter Property="Background" Value="{DynamicResource NeuDangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Statut}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Statut}" Value="Completed">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Statut}" Value="Cancelled">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource VoyageDeleteBtnStyle}"
                                Command="{Binding DataContext.DeleteVoyageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [ProdBreadcrumbInfra], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}" />
                        <TextBlock Text=" &gt; " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                        <TextBlock Text="{Binding [VoyageBreadcrumb], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding [VoyagePageSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                               FontSize="13" Margin="0,4,0,0" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource NeuButtonStyle}"
                        Background="{DynamicResource NeuAccentBrush}"
                        Foreground="White" Padding="16,10" FontWeight="SemiBold"
                        Command="{Binding AddVoyageCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [VoyageAddButton], Source={x:Static loc:LanguageManager.Instance}}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Voyages table -->
            <ContentControl Grid.Row="1" Style="{StaticResource NeuDashCardStyle}" Margin="8,0,8,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [VoyageTableTitle],    Source={x:Static loc:LanguageManager.Instance}}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextPrimaryBrush}" />
                            <TextBlock Text="{Binding [VoyageTableSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                                       FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" CornerRadius="10" Padding="12,5">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}">
                                <Run Text="{Binding Voyages.Count, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{Binding [VoyageCountBadge], Source={x:Static loc:LanguageManager.Instance}, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,16,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [VoyageColCamion],       Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding [VoyageColChauffeur],    Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="{Binding [VoyageColCiterne],      Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="{Binding [VoyageColDepart],       Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="4" Text="{Binding [VoyageColArrivee],      Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="{Binding [VoyageColLieuDepart],   Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="6" Text="{Binding [VoyageColLieuTerminal], Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="7" Text="{Binding [VoyageColStatut],       Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="8" Text="{Binding [VoyageColActions],      Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource ColHeaderStyle}" HorizontalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2" MinHeight="80">
                        <ItemsControl ItemsSource="{Binding Voyages}"
                                      ItemTemplate="{StaticResource VoyageRowTemplate}"
                                      AlternationCount="2" />
                        <Border Background="#33000000" CornerRadius="8"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{DynamicResource NeuAccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding [VoyageEmpty], Source={x:Static loc:LanguageManager.Instance}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource NeuTextSecondaryBrush}" Margin="0,24,0,24">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                                <Condition Binding="{Binding Voyages.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </ContentControl>


            </Grid>
    </ScrollViewer>

</UserControl>