                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"  Text="#"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0,0,0,8" />
                                <TextBlock Grid.Row="0" Grid.Column="1"  Text="{Binding [NouveauVoyageSumDate], Source={x:Static loc:LanguageManager.Instance}}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0,0,0,8" />
                                <TextBlock Grid.Row="0" Grid.Column="2"  Text="{Binding [NouveauVoyageSumType],    Source={x:Static loc:LanguageManager.Instance}}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" Padding="0,0,0,8" />
                                <TextBlock Grid.Row="0" Grid.Column="3"  Text="{Binding [NouveauVoyageSumPartie],  Source={x:Static loc:LanguageManager.Instance}}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" Padding="0,0,0,8" />
                                <TextBlock Grid.Row="0" Grid.Column="4"  Text="{Binding [NouveauVoyageSumProduit], Source={x:Static loc:LanguageManager.Instance}}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" Padding="0,0,0,8" />
                                <TextBlock Grid.Row="0" Grid.Column="5"  Text="{Binding [NouveauVoyageSumQte],     Source={x:Static loc:LanguageManager.Instance}}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0,0,0,8" />
                                <TextBlock Grid.Row="0" Grid.Column="6"  Text="{Binding [NouveauVoyageSumPrixU],   Source={x:Static loc:LanguageManager.Instance}}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" Padding="0,0,0,8" />
                                <TextBlock Grid.Row="0" Grid.Column="7"  Text="{Binding [NouveauVoyageSumRemise],  Source={x:Static loc:LanguageManager.Instance}}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0,0,0,8" />
                                <TextBlock Grid.Row="0" Grid.Column="8"  Text="{Binding [NouveauVoyageSumMontant], Source={x:Static loc:LanguageManager.Instance}}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" Padding="0,0,0,8" />
                                <TextBlock Grid.Row="0" Grid.Column="9"  Text="Chq"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0,0,0,8" />
                                <!-- 1px divider spanning all columns -->
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="11"
                                        Background="{DynamicResource NeuInputFillBrush}" Height="1" />
                            </Grid>
                            <ItemsControl Grid.Row="1" Margin="0,4,0,0"
                                         ItemsSource="{Binding Transactions}" ItemTemplate="{StaticResource TransactionRowTemplate}"
                                         AlternationCount="2" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NeuInputFillBrush}" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Counters + Error -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource BadgeStyle}" Margin="0,0,8,0">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}">
                                <Run Text="{Binding Transactions.Count, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{Binding [NouveauVoyageFooterTransactions], Source={x:Static loc:LanguageManager.Instance}, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource BadgeStyle}" Margin="0,0,14,0">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}">
                                <Run Text="{Binding StockItems.Count, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{Binding [NouveauVoyageFooterStocks], Source={x:Static loc:LanguageManager.Instance}, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                                     Value="Visible">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="13"
                                           Foreground="{DynamicResource NeuDangerBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="12" Foreground="{DynamicResource NeuDangerBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Cancel -->
                    <Button Grid.Column="1"
                            Style="{StaticResource DlgSecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="OnCancelClick"
                            Content="{Binding [NouveauVoyageBtnCancel], Source={x:Static loc:LanguageManager.Instance}}" />
                    <!-- Save -->
                    <Button Grid.Column="2"
                            Style="{StaticResource DlgPrimaryButtonStyle}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0">
                                <ui:ProgressRing.Style>
                                    <Style TargetType="ui:ProgressRing">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:ProgressRing.Style>
                            </ui:ProgressRing>
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="{Binding [NouveauVoyageBtnCreate], Source={x:Static loc:LanguageManager.Instance}}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>

</ui:FluentWindow>
