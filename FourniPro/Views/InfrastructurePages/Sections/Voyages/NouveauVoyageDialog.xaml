<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.Voyages.NouveauVoyageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FourniPro.Localization"
                 xmlns:vm="clr-namespace:FourniPro.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:NouveauVoyageViewModel}"
                 Title="{Binding [NouveauVoyageTitle], Source={x:Static loc:LanguageManager.Instance}}"
                 Width="1380" Height="800"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource NeuBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="DlgCardBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuBackgroundBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="12" />
            <Setter Property="Padding"         Value="20,18" />
        </Style>
        <Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DlgFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="Margin"     Value="0,0,0,6" />
        </Style>
        <Style x:Key="DlgInputBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="10,6" />
            <Setter Property="MinHeight"       Value="36" />
        </Style>
        <Style x:Key="DlgComputedBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="10,6" />
            <Setter Property="MinHeight"       Value="36" />
        </Style>
        <Style x:Key="DlgInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness"          Value="0" />
            <Setter Property="Background"               Value="Transparent" />
            <Setter Property="Foreground"               Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="FontSize"                 Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="DlgIconCircleStyle" TargetType="Border">
            <Setter Property="Width"             Value="28" />
            <Setter Property="Height"            Value="28" />
            <Setter Property="CornerRadius"      Value="14" />
            <Setter Property="Background"        Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,10,0" />
        </Style>
        <Style x:Key="DlgCloseButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="32" />
            <Setter Property="Height"          Value="32" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="20,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="14,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallAddBtnStyle" TargetType="Button">
            <Setter Property="Width"      Value="34" />
            <Setter Property="Height"     Value="34" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniDeleteBtnStyle" TargetType="Button">
            <Setter Property="Width"      Value="26" />
            <Setter Property="Height"     Value="26" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource NeuDangerBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="{DynamicResource NeuActionDeleteBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuDangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background"        Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="CornerRadius"      Value="10" />
            <Setter Property="Padding"           Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DisabledInputBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="10,6" />
            <Setter Property="MinHeight"       Value="36" />
            <Setter Property="Opacity"         Value="0.55" />
        </Style>

        <Style x:Key="TabBtnStyle" TargetType="Button">
            <Setter Property="Padding"    Value="12,7" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StockItemTemplate">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ProduitNom}" FontSize="12"
                           Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Quantite}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource NeuAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource MiniDeleteBtnStyle}"
                        Command="{Binding DataContext.RemoveStockCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                        CommandParameter="{Binding}">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TransactionRowTemplate">
            <Border Padding="0,10,0,10"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- # -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AlternationIndexToRowNumberConverter}}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource NeuTextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <!-- Date -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Date, StringFormat={}{0:dd/MM/yy}, TargetNullValue=_}"
                               FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <!-- Type badge -->
                    <Border Grid.Column="2" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Vente">
                                        <Setter Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Credit">
                                        <Setter Property="Background" Value="#E8A838" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Achat">
                                        <Setter Property="Background" Value="{DynamicResource NeuAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Frais">
                                        <Setter Property="Background" Value="{DynamicResource NeuDangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <!-- Partie -->
                    <TextBlock Grid.Column="3" Text="{Binding Partie, TargetNullValue=_}"
                               FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- Produit -->
                    <TextBlock Grid.Column="4" Text="{Binding ProduitNom, TargetNullValue=_}"
                               FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- Qté -->
                    <TextBlock Grid.Column="5" Text="{Binding Quantite, TargetNullValue=_}"
                               FontSize="12" Foreground="{DynamicResource NeuTextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <!-- Prix U -->
                    <TextBlock Grid.Column="6" FontSize="12"
                               Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding PrixUnitaire, StringFormat={}{0:N2}, TargetNullValue=_}" />
                    </TextBlock>
                    <!-- Remise -->
                    <TextBlock Grid.Column="7" Text="{Binding Remise, StringFormat={}{0:N1}, TargetNullValue=_}"
                               FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <!-- Montant -->
                    <TextBlock Grid.Column="8" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource NeuAccentBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding MontantTotal, StringFormat={}{0:N2}, TargetNullValue=_}" />
                        <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                    </TextBlock>
                    <!-- Chq -->
                    <TextBlock Grid.Column="9" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="" />
                                <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCheque}" Value="True">
                                        <Setter Property="Text"       Value="&#x2713;" />
                                        <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Delete -->
                    <Button Grid.Column="10" Style="{StaticResource MiniDeleteBtnStyle}"
                            Command="{Binding DataContext.RemoveTransactionCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                            CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="11" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <!-- Outer shell -->
    <Border CornerRadius="14"
            Background="{DynamicResource NeuBackgroundBrush}"
            BorderBrush="{DynamicResource NeuInputFillBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="22,10,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource DlgCloseButtonStyle}" Click="OnCloseClick" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </Button>

                <!-- Title + badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,16,0">
                    <ui:SymbolIcon Symbol="VehicleTruck24" FontSize="20" Foreground="{DynamicResource NeuAccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [NouveauVoyageTitle], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NeuAccentBrush}" />
                        <TextBlock Text="{Binding [NouveauVoyageSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" Foreground="{DynamicResource NeuTextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource BadgeStyle}" Margin="14,0,0,0">
                        <TextBlock Text="{Binding [NouveauVoyageStatutBadge], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Stock Restant pills + Frais pill — compact row in header, right-aligned -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- One pill per StockRestantItem -->
                    <ItemsControl ItemsSource="{Binding StockRestantItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,6,0"
                                        Background="{DynamicResource NeuInputFillBrush}"
                                        CornerRadius="8"
                                        Padding="10,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource NeuDangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Box24" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource NeuDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding ProduitNom}" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" MaxWidth="90" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}" Margin="0,0,4,0" />
                                        <TextBlock FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource NeuDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding QuantiteRestante, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="/" FontSize="11" Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="2,0" />
                                        <TextBlock Text="{Binding QuantiteInitiale, Mode=OneWay}" FontSize="11"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Frais total pill — always visible -->
                    <Border Background="{DynamicResource NeuInputFillBrush}"
                            BorderBrush="{DynamicResource NeuInputFillBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Money24" FontSize="11" Foreground="{DynamicResource NeuAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Frais" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NeuTextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource NeuAccentBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding FraisTotal, StringFormat={}{0:N2}, Mode=OneWay}" />
                                <Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" FontSize="10" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NeuInputFillBrush}" VerticalAlignment="Bottom" />

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14,18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 3-column area -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="520" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="520" />
                        </Grid.ColumnDefinitions>

                        <!-- COL 1: Détails -->
                        <Border Grid.Column="0" Style="{StaticResource DlgCardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Map24" FontSize="13" Foreground="{DynamicResource NeuAccentBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauVoyageColDetails], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}" />
                                </StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [NouveauVoyageChauffeur], Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource DlgFieldLabelStyle}" />
                                        <ComboBox Style="{DynamicResource NeuComboBoxStyle}" MinWidth="0" ItemsSource="{Binding Chauffeurs}"
                                                  SelectedItem="{Binding SelectedChauffeur}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Nom}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding [NouveauVoyageCamion], Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource DlgFieldLabelStyle}" />
                                        <ComboBox Style="{DynamicResource NeuComboBoxStyle}" MinWidth="0" ItemsSource="{Binding Camions}"
                                                  SelectedItem="{Binding SelectedCamion}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Matricule}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{Binding [NouveauVoyageCiterne], Source={x:Static loc:LanguageManager.Instance}}" Style="{StaticResource DlgFieldLabelStyle}" />
                                        <ComboBox Style="{DynamicResource NeuComboBoxStyle}" MinWidth="0" ItemsSource="{Binding Citernes}"
                                                  SelectedItem="{Binding SelectedCiterne}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MatriculeCiterne}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{DynamicResource NeuInputFillBrush}" Margin="0,0,0,14" />

                                <!-- LieuDepart / LieuTerminal (start editable, end disabled) -->
                                <Grid Margin="0,0,0,10">
