<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.Avoirs.DetailAvoirDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FourniPro.Localization"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="{Binding [DetailAvoirTitle], Source={x:Static loc:LanguageManager.Instance}}"
                 Width="900" Height="720"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource NeuBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <Style x:Key="DlgCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="20,18"/>
            <Setter Property="Margin"          Value="0,0,0,12"/>
        </Style>
        <Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource NeuTextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DlgIconCircleStyle" TargetType="Border">
            <Setter Property="Width"         Value="28"/>
            <Setter Property="Height"        Value="28"/>
            <Setter Property="CornerRadius"  Value="14"/>
            <Setter Property="Background"    Value="{DynamicResource NeuInputFillBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"        Value="0,0,10,0"/>
        </Style>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Foreground"   Value="{DynamicResource NeuTextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DetailAccentValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}"/>
        </Style>
        <Style x:Key="DlgCloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"  Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource NeuAccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- Outer shell -->
    <Border CornerRadius="14"
            Background="{DynamicResource NeuBackgroundBrush}"
            BorderBrush="{DynamicResource NeuInputFillBrush}"
            BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Header ─── -->
            <Grid Grid.Row="0" Margin="22,18,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Popup icon on the left -->
                <Border Grid.Column="0" Style="{StaticResource DlgIconCircleStyle}">
                    <ui:SymbolIcon Symbol="ArrowCircleLeft24" FontSize="14"
                                   Foreground="{DynamicResource NeuAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [DetailAvoirTitle], Source={x:Static loc:LanguageManager.Instance}}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource NeuJaugAccentBrush}"/>
                    <TextBlock Text="{Binding NumeroAvoir}"
                               FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                </StackPanel>

                <!-- Close X on the right -->
                <Button Grid.Column="2" Style="{StaticResource DlgCloseButtonStyle}" Click="OnCloseClick">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </Button>
            </Grid>

            <!-- ─── Body: 2×2 card grid ─── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="18,8,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Card 1 top-left: Identification ── -->
                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [DetailAvoirCardIdentification], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}"/>
                            </StackPanel>

                            <!-- N° Avoir | Date -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelNumero], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding NumeroAvoir, TargetNullValue='—'}"
                                               Style="{StaticResource DetailAccentValueStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelDate], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding DateAvoir, StringFormat=dd/MM/yyyy, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource NeuInputFillBrush}" Height="1" Margin="0,14"/>

                            <!-- Vente | Crédit -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelVente], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding NumeroVente, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelCredit], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding NumeroCredit, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource NeuInputFillBrush}" Height="1" Margin="0,14"/>

                            <!-- Client -->
                            <StackPanel>
                                <TextBlock Text="{Binding [DetailAvoirLabelClient], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding ClientNom, TargetNullValue='—'}"
                                           Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 2 top-right: Montant pill + Raison ── -->
                    <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Money24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [DetailAvoirCardMontant], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}"/>
                            </StackPanel>

                            <!-- Montant pill -->
                            <Border Background="{DynamicResource NeuInputFillBrush}"
                                    CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [DetailAvoirLabelMontant], Source={x:Static loc:LanguageManager.Instance}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding [DetailAvoirMontantSub], Source={x:Static loc:LanguageManager.Instance}}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource NeuTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MontantAvoir, StringFormat='{}{0:N2} DH', TargetNullValue='— DH'}"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource NeuTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Raison -->
                            <TextBlock Text="{Binding [DetailAvoirLabelRaison], Source={x:Static loc:LanguageManager.Instance}}"
                                       Style="{StaticResource DetailLabelStyle}"/>
                            <Border Background="{DynamicResource NeuInputFillBrush}"
                                    CornerRadius="6" Padding="10,6"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Raison, TargetNullValue='—'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource NeuAccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 3 bottom-left: Produit & Financier ── -->
                    <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Beaker24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [DetailAvoirCardDetails], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}"/>
                            </StackPanel>

                            <!-- Produit | Quantité -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelProduit], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding ProduitNom, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelQuantite], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding Quantite, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource NeuInputFillBrush}" Height="1" Margin="0,14"/>

                            <!-- Prix unitaire | Employé -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelPrix], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding PrixUnitaire, StringFormat='{}{0:N2} DH', TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelEmploye], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding EmployeNom, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 4 bottom-right: Audit & Note ── -->
                    <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource DlgCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource DlgIconCircleStyle}">
                                    <ui:SymbolIcon Symbol="Note24" FontSize="14"
                                                   Foreground="{DynamicResource NeuAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [DetailAvoirCardAudit], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgCardTitleStyle}"/>
                            </StackPanel>

                            <!-- AjoutePar | DateCreation -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelAjoutePar], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding AjouteParNom, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelDateCreation], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding DateCreation, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource NeuInputFillBrush}" Height="1" Margin="0,14"/>

                            <!-- ModifiePar | DateModification -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelModifiePar], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding ModifieParNom, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}"/>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [DetailAvoirLabelDateModification], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding DateModification, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue='—'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource NeuInputFillBrush}" Height="1" Margin="0,0,0,14"/>

                            <!-- Note -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding [DetailAvoirLabelNote], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Note, TargetNullValue='—'}"
                                           Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>

                            <!-- Fichier -->
                            <StackPanel>
                                <TextBlock Text="{Binding [DetailAvoirLabelFichier], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding ReferenceFile, TargetNullValue='—'}"
                                           Style="{StaticResource DetailValueStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>

            <!-- ─── Footer ─── -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,1,0,0" Padding="22,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DlgSecondaryButtonStyle}" Margin="0,0,10,0"
                            Content="{Binding [DetailAvoirClose], Source={x:Static loc:LanguageManager.Instance}}"
                            Click="OnCloseClick"/>
                    <Button Style="{StaticResource DlgPrimaryButtonStyle}" Click="OnEditClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [DetailAvoirEdit], Source={x:Static loc:LanguageManager.Instance}}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

</ui:FluentWindow>
