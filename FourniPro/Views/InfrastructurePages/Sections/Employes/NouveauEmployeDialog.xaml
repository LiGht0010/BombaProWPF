<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.Employes.NouveauEmployeDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FourniPro.Localization"
                 xmlns:vm="clr-namespace:FourniPro.ViewModels"
                 xmlns:conv="clr-namespace:FourniPro.Converters"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:NouveauEmployeViewModel}"
                 Title="{Binding [NouveauEmployeTitle], Source={x:Static loc:LanguageManager.Instance}}"
                 Width="900" Height="780"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource NeuBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />

        <Style x:Key="InvisibleWhenTrue" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSaving}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CollapseWhenNull" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DlgCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuBackgroundBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="12" />
            <Setter Property="Padding"         Value="20,18" />
            <Setter Property="Margin"          Value="0,0,0,12" />
        </Style>

        <Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DlgLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="Margin"     Value="0,0,0,5" />
        </Style>

        <Style x:Key="DlgInputBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="10,6" />
            <Setter Property="MinHeight"       Value="36" />
        </Style>

        <Style x:Key="DlgTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness"          Value="0" />
            <Setter Property="Background"               Value="Transparent" />
            <Setter Property="Foreground"               Value="{DynamicResource NeuTextPrimaryBrush}" />
            <Setter Property="FontSize"                 Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DlgIconCircleStyle" TargetType="Border">
            <Setter Property="Width"             Value="28" />
            <Setter Property="Height"            Value="28" />
            <Setter Property="CornerRadius"      Value="14" />
            <Setter Property="Background"        Value="{DynamicResource NeuInputFillBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,10,0" />
        </Style>

        <Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource NeuAccentBrush}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="20,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="14,10" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgCloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width"           Value="32" />
            <Setter Property="Height"          Value="32" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- â•â•â• Outer card shell â•â•â• -->
    <Border CornerRadius="14"
            Background="{DynamicResource NeuBackgroundBrush}"
            BorderBrush="{DynamicResource NeuInputFillBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- â”€â”€â”€ Header â”€â”€â”€ -->
            <Grid Grid.Row="0" Margin="18,16,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource DlgCloseButtonStyle}"
                        Click="OnCancelClick">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                    <ui:SymbolIcon Symbol="PersonAdd24" FontSize="18"
                                   Foreground="{DynamicResource NeuAccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [NouveauEmployeTitle], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource NeuAccentBrush}" />
                        <TextBlock Text="{Binding [NouveauEmployeSubtitle], Source={x:Static loc:LanguageManager.Instance}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- â”€â”€â”€ Scrollable form â”€â”€â”€ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="18,4,18,0">
                <StackPanel>

                    <!-- â•â• 2Ã—2 grid of cards â•â• -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- â”€â”€ Card 1 (top-left): IdentitÃ© â”€â”€ -->
                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource DlgCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Person24" FontSize="13"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauEmployeIdentiteSection], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}" />
                                </StackPanel>

                                <!-- PrÃ©nom -->
                                <TextBlock Text="{Binding [NouveauEmployeLabelPrenom], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}" />
                                <Border Style="{StaticResource DlgInputBorderStyle}" Margin="0,0,0,12">
                                    <TextBox Text="{Binding Prenom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DlgTextBoxStyle}" />
                                </Border>

                                <!-- Nom -->
                                <TextBlock Text="{Binding [NouveauEmployeLabelNom], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}" />
                                <Border Style="{StaticResource DlgInputBorderStyle}" Margin="0,0,0,12">
                                    <TextBox Text="{Binding Nom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DlgTextBoxStyle}" />
                                </Border>

                                <!-- CIN -->
                                <TextBlock Text="{Binding [NouveauEmployeLabelCIN], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}" />
                                <Border Style="{StaticResource DlgInputBorderStyle}">
                                    <TextBox Text="{Binding CIN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DlgTextBoxStyle}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- â”€â”€ Card 2 (top-right): Contact â”€â”€ -->
                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource DlgCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Call24" FontSize="13"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauEmployeContactSection], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}" />
                                </StackPanel>

                                <!-- TÃ©lÃ©phone -->
                                <TextBlock Text="{Binding [NouveauEmployeLabelTelephone], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}" />
                                <Border Style="{StaticResource DlgInputBorderStyle}" Margin="0,0,0,12">
                                    <TextBox Text="{Binding Telephone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DlgTextBoxStyle}" />
                                </Border>

                                <!-- Adresse -->
                                <TextBlock Text="{Binding [NouveauEmployeLabelAdresse], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}" />
                                <Border Style="{StaticResource DlgInputBorderStyle}">
                                    <TextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DlgTextBoxStyle}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinHeight="50" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- â”€â”€ Card 3 (bottom-left): Poste â”€â”€ -->
                        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource DlgCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Briefcase24" FontSize="13"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauEmployePosteSection], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}" />
                                </StackPanel>

                                <!-- Poste -->
                                <TextBlock Text="{Binding [NouveauEmployeLabelPoste], Source={x:Static loc:LanguageManager.Instance}}"
                                           Style="{StaticResource DlgLabelStyle}" />
                                <Border Style="{StaticResource DlgInputBorderStyle}">
                                    <TextBox Text="{Binding Poste, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DlgTextBoxStyle}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- â”€â”€ Card 4 (bottom-right): Salaire â”€â”€ -->
                        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource DlgCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource DlgIconCircleStyle}">
                                        <ui:SymbolIcon Symbol="Money24" FontSize="13"
                                                       Foreground="{DynamicResource NeuAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding [NouveauEmployeSalaireSection], Source={x:Static loc:LanguageManager.Instance}}"
                                               Style="{StaticResource DlgCardTitleStyle}" />
                                </StackPanel>

                                <!-- Salaire pill -->
                                <Border Background="{DynamicResource NeuInputFillBrush}"
                                        CornerRadius="10" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [NouveauEmployeLabelSalaire], Source={x:Static loc:LanguageManager.Instance}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding [NouveauEmployeSalaireHint], Source={x:Static loc:LanguageManager.Instance}}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource NeuTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource DlgInputBorderStyle}"
                                                MinWidth="280" Margin="12,0,0,0">
                                            <TextBox Text="{Binding Salaire, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DlgTextBoxStyle}"
                                                     FontSize="20" FontWeight="Bold"
                                                     Foreground="{DynamicResource NeuTextPrimaryBrush}"
                                                     HorizontalContentAlignment="Right" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- â”€â”€â”€ Footer â”€â”€â”€ -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource NeuInputFillBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Error toast -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CollapseWhenNull}"
                            Background="{DynamicResource NeuDangerBrush}"
                            Opacity="0.92"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="13"
                                           Foreground="White" VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="12" Foreground="White"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Cancel -->
                    <Button Grid.Column="1"
                            Style="{StaticResource DlgSecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Content="{Binding [NouveauEmployeCancel], Source={x:Static loc:LanguageManager.Instance}}"
                            Click="OnCancelClick" />

                    <!-- Save -->
                    <Button Grid.Column="2"
                            Style="{StaticResource DlgPrimaryButtonStyle}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing Width="14" Height="14"
                                             IsIndeterminate="True"
                                             Foreground="White"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ui:SymbolIcon Symbol="Save24" FontSize="14"
                                           VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding [NouveauEmployeSave], Source={x:Static loc:LanguageManager.Instance}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Text" Value="{Binding [NouveauEmployeSaving], Source={x:Static loc:LanguageManager.Instance}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</ui:FluentWindow>
