<ui:FluentWindow x:Class="FourniPro.Views.InfrastructurePages.Sections.Employes.DetailEmployeDialog"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 xmlns:loc="clr-namespace:FourniPro.Localization"
				 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				 mc:Ignorable="d"
				 Title="{Binding [DetailEmployeTitle], Source={x:Static loc:LanguageManager.Instance}}"
				 Width="900" Height="720"
				 WindowStartupLocation="CenterOwner"
				 ResizeMode="NoResize"
				 ShowInTaskbar="False"
				 WindowBackdropType="None"
				 ExtendsContentIntoTitleBar="True"
				 Background="{DynamicResource NeuBackgroundBrush}">

	<ui:FluentWindow.Resources>
		<Style x:Key="DlgCardStyle" TargetType="Border">
			<Setter Property="Background"      Value="{DynamicResource NeuBackgroundBrush}" />
			<Setter Property="BorderBrush"     Value="{DynamicResource NeuInputFillBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius"    Value="12" />
			<Setter Property="Padding"         Value="20,18" />
			<Setter Property="Margin"          Value="0,0,0,12" />
		</Style>
		<Style x:Key="DlgCardTitleStyle" TargetType="TextBlock">
			<Setter Property="FontSize"          Value="14" />
			<Setter Property="FontWeight"        Value="SemiBold" />
			<Setter Property="Foreground"        Value="{DynamicResource NeuTextPrimaryBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style x:Key="DlgIconCircleStyle" TargetType="Border">
			<Setter Property="Width"             Value="28" />
			<Setter Property="Height"            Value="28" />
			<Setter Property="CornerRadius"      Value="14" />
			<Setter Property="Background"        Value="{DynamicResource NeuInputFillBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin"            Value="0,0,10,0" />
		</Style>
		<Style x:Key="DetailLabelStyle" TargetType="TextBlock">
			<Setter Property="FontSize"   Value="10" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource NeuTextSecondaryBrush}" />
			<Setter Property="Margin"     Value="0,0,0,4" />
		</Style>
		<Style x:Key="DetailValueStyle" TargetType="TextBlock">
			<Setter Property="FontSize"     Value="13" />
			<Setter Property="Foreground"   Value="{DynamicResource NeuTextPrimaryBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style x:Key="DetailAccentValueStyle" TargetType="TextBlock">
			<Setter Property="FontSize"   Value="15" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource NeuAccentBrush}" />
		</Style>
		<Style x:Key="DlgCloseButtonStyle" TargetType="Button">
			<Setter Property="Background"      Value="Transparent" />
			<Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Width"           Value="32" />
			<Setter Property="Height"          Value="32" />
			<Setter Property="Cursor"          Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="DlgSecondaryButtonStyle" TargetType="Button">
			<Setter Property="Background"      Value="Transparent" />
			<Setter Property="Foreground"      Value="{DynamicResource NeuTextSecondaryBrush}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding"         Value="14,10" />
			<Setter Property="FontSize"        Value="13" />
			<Setter Property="FontWeight"      Value="SemiBold" />
			<Setter Property="Cursor"          Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
								CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuInputFillBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="DlgPrimaryButtonStyle" TargetType="Button">
			<Setter Property="Background"      Value="{DynamicResource NeuAccentBrush}" />
			<Setter Property="Foreground"      Value="White" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding"         Value="20,10" />
			<Setter Property="FontSize"        Value="13" />
			<Setter Property="FontWeight"      Value="SemiBold" />
			<Setter Property="Cursor"          Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
								CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="{DynamicResource NeuAccentHoverBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</ui:FluentWindow.Resources>

	<Border CornerRadius="14"
			Background="{DynamicResource NeuBackgroundBrush}"
			BorderBrush="{DynamicResource NeuInputFillBrush}"
			BorderThickness="1" SnapsToDevicePixels="True">
		<Border.Effect>
			<DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />
		</Border.Effect>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Header -->
			<Grid Grid.Row="0" Margin="22,18,18,8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Style="{StaticResource DlgCloseButtonStyle}" Click="OnCloseClick">
					<ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
				</Button>

				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
					<ui:SymbolIcon Symbol="Person24" FontSize="18"
								   Foreground="{DynamicResource NeuAccentBrush}"
								   VerticalAlignment="Center" Margin="0,0,8,0" />
					<StackPanel VerticalAlignment="Center">
						<TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource NeuAccentBrush}">
							<Run Text="{Binding Prenom, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Nom, Mode=OneWay}" />
						</TextBlock>
						<TextBlock Text="{Binding [DetailEmployeTitle], Source={x:Static loc:LanguageManager.Instance}}"
								   FontSize="12" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
					</StackPanel>
				</StackPanel>
			</Grid>

			<!-- Scrollable content -->
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,0">
				<StackPanel>
					<Grid Margin="0,8,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="12" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- Card 1 (top-left): Identite -->
						<Border Grid.Column="0" Grid.Row="0" Style="{StaticResource DlgCardStyle}">
							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,16">
									<Border Style="{StaticResource DlgIconCircleStyle}">
										<ui:SymbolIcon Symbol="Person24" FontSize="13"
													   Foreground="{DynamicResource NeuAccentBrush}"
													   HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Border>
									<TextBlock Text="{Binding [DetailEmployeIdentiteSection], Source={x:Static loc:LanguageManager.Instance}}"
											   Style="{StaticResource DlgCardTitleStyle}" />
								</StackPanel>
								<Grid Margin="0,0,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="1" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0" Margin="0,0,12,0">
										<TextBlock Text="{Binding [DetailEmployeLabelPrenom], Source={x:Static loc:LanguageManager.Instance}}"
												   Style="{StaticResource DetailLabelStyle}" />
										<TextBlock Style="{StaticResource DetailValueStyle}"
												   Text="{Binding Prenom, TargetNullValue='--', FallbackValue='--'}" />
									</StackPanel>
									<Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />
									<StackPanel Grid.Column="2" Margin="12,0,0,0">
										<TextBlock Text="{Binding [DetailEmployeLabelNom], Source={x:Static loc:LanguageManager.Instance}}"
												   Style="{StaticResource DetailLabelStyle}" />
										<TextBlock Style="{StaticResource DetailValueStyle}"
												   Text="{Binding Nom, TargetNullValue='--', FallbackValue='--'}" />
									</StackPanel>
								</Grid>
								<TextBlock Text="{Binding [DetailEmployeLabelCIN], Source={x:Static loc:LanguageManager.Instance}}"
										   Style="{StaticResource DetailLabelStyle}" />
								<TextBlock Style="{StaticResource DetailValueStyle}"
										   Text="{Binding CIN, TargetNullValue='--', FallbackValue='--'}" />
							</StackPanel>
						</Border>

						<!-- Card 2 (top-right): Contact -->
						<Border Grid.Column="2" Grid.Row="0" Style="{StaticResource DlgCardStyle}">
							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,16">
									<Border Style="{StaticResource DlgIconCircleStyle}">
										<ui:SymbolIcon Symbol="Call24" FontSize="13"
													   Foreground="{DynamicResource NeuAccentBrush}"
													   HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Border>
									<TextBlock Text="{Binding [DetailEmployeContactSection], Source={x:Static loc:LanguageManager.Instance}}"
											   Style="{StaticResource DlgCardTitleStyle}" />
								</StackPanel>
								<TextBlock Text="{Binding [DetailEmployeLabelTelephone], Source={x:Static loc:LanguageManager.Instance}}"
										   Style="{StaticResource DetailLabelStyle}" />
								<TextBlock Style="{StaticResource DetailValueStyle}" Margin="0,0,0,14"
										   Text="{Binding Telephone, TargetNullValue='--', FallbackValue='--'}" />
								<TextBlock Text="{Binding [DetailEmployeLabelAdresse], Source={x:Static loc:LanguageManager.Instance}}"
										   Style="{StaticResource DetailLabelStyle}" />
								<TextBlock Style="{StaticResource DetailValueStyle}"
										   Text="{Binding Address, TargetNullValue='--', FallbackValue='--'}" />
							</StackPanel>
						</Border>

						<!-- Card 3 (bottom-left): Poste -->
						<Border Grid.Column="0" Grid.Row="1" Style="{StaticResource DlgCardStyle}">
							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,16">
									<Border Style="{StaticResource DlgIconCircleStyle}">
										<ui:SymbolIcon Symbol="Briefcase24" FontSize="13"
													   Foreground="{DynamicResource NeuAccentBrush}"
													   HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Border>
									<TextBlock Text="{Binding [DetailEmployePosteSection], Source={x:Static loc:LanguageManager.Instance}}"
											   Style="{StaticResource DlgCardTitleStyle}" />
								</StackPanel>
								<TextBlock Text="{Binding [DetailEmployeLabelPoste], Source={x:Static loc:LanguageManager.Instance}}"
										   Style="{StaticResource DetailLabelStyle}" />
								<TextBlock Style="{StaticResource DetailAccentValueStyle}"
										   Text="{Binding Poste, TargetNullValue='--', FallbackValue='--'}" />
							</StackPanel>
						</Border>

						<!-- Card 4 (bottom-right): Salaire + Audit -->
						<Border Grid.Column="2" Grid.Row="1" Style="{StaticResource DlgCardStyle}">
							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
									<Border Style="{StaticResource DlgIconCircleStyle}">
										<ui:SymbolIcon Symbol="Money24" FontSize="13"
													   Foreground="{DynamicResource NeuAccentBrush}"
													   HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Border>
									<TextBlock Text="{Binding [DetailEmployeSalaireSection], Source={x:Static loc:LanguageManager.Instance}}"
											   Style="{StaticResource DlgCardTitleStyle}" />
								</StackPanel>
								<Border Background="{DynamicResource NeuInputFillBrush}"
										CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0" VerticalAlignment="Center">
											<TextBlock Text="{Binding [DetailEmployeLabelSalaire], Source={x:Static loc:LanguageManager.Instance}}"
													   FontSize="11" FontWeight="SemiBold"
													   Foreground="{DynamicResource NeuTextSecondaryBrush}" />
											<TextBlock Text="{Binding [DetailEmployeSalaireHint], Source={x:Static loc:LanguageManager.Instance}}"
													   FontSize="10" Foreground="{DynamicResource NeuTextSecondaryBrush}" />
										</StackPanel>
										<TextBlock Grid.Column="1" FontSize="20" FontWeight="Bold"
												   Foreground="{DynamicResource NeuTextPrimaryBrush}" VerticalAlignment="Center">
											<Run Text="{Binding Salaire, StringFormat='{}{0:N2}', TargetNullValue='--', FallbackValue='--'}" />
											<Run Text=" DH" Foreground="{DynamicResource NeuTextSecondaryBrush}" FontSize="13" FontWeight="Normal" />
										</TextBlock>
									</Grid>
								</Border>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
									<Border Style="{StaticResource DlgIconCircleStyle}">
										<ui:SymbolIcon Symbol="History24" FontSize="13"
													   Foreground="{DynamicResource NeuAccentBrush}"
													   HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Border>
									<TextBlock Text="{Binding [DetailEmployeAuditSection], Source={x:Static loc:LanguageManager.Instance}}"
											   Style="{StaticResource DlgCardTitleStyle}" />
								</StackPanel>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="1" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0" Margin="0,0,12,0">
										<TextBlock Text="{Binding [DetailEmployeLabelCreePar], Source={x:Static loc:LanguageManager.Instance}}"
												   Style="{StaticResource DetailLabelStyle}" />
										<TextBlock Style="{StaticResource DetailAccentValueStyle}"
												   Text="{Binding AjouteParNom, TargetNullValue='--', FallbackValue='--'}" />
										<TextBlock FontSize="11" Foreground="{DynamicResource NeuTextSecondaryBrush}"
												   Text="{Binding DateCreation, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='--'}" />
									</StackPanel>
									<Border Grid.Column="1" Background="{DynamicResource NeuInputFillBrush}" />
									<StackPanel Grid.Column="2" Margin="12,0,0,0">
										<TextBlock Text="{Binding [DetailEmployeLabelModifiePar], Source={x:Static loc:LanguageManager.Instance}}"
												   Style="{StaticResource DetailLabelStyle}" />
										<TextBlock Style="{StaticResource DetailAccentValueStyle}"
												   Text="{Binding ModifieParNom, TargetNullValue='--', FallbackValue='--'}" />
										<TextBlock FontSize="11" Foreground="{DynamicResource NeuTextSecondaryBrush}"
												   Text="{Binding DateModification, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='--'}" />
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>

					</Grid>
				</StackPanel>
			</ScrollViewer>

			<!-- Footer -->
			<Border Grid.Row="2"
					BorderBrush="{DynamicResource NeuInputFillBrush}"
					BorderThickness="0,1,0,0"
					Padding="18,12">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Style="{StaticResource DlgSecondaryButtonStyle}"
							Margin="0,0,8,0"
							Content="{Binding [DetailEmployeClose], Source={x:Static loc:LanguageManager.Instance}}"
							Click="OnCloseClick" />
					<Button Style="{StaticResource DlgPrimaryButtonStyle}" Click="OnEditClick">
						<StackPanel Orientation="Horizontal">
							<ui:SymbolIcon Symbol="Edit24" FontSize="14" VerticalAlignment="Center" />
							<TextBlock Text="{Binding [DetailEmployeEdit], Source={x:Static loc:LanguageManager.Instance}}"
									   Margin="6,0,0,0" VerticalAlignment="Center" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>

		</Grid>
	</Border>
</ui:FluentWindow>